% \subsection{Keeping listings together}\label{KeepListings}
%
% Now we decide where listings may break across pages (see 
% \cref{KeepListingsUsage} for the options).
% Every listing of |minted| is a list of \textsf{fancyvrb}, which sets each 
% line as a box of its own in the vertical list, with a penalty between two 
% lines.
% \textsf{fancyvrb} knows the number of lines only at the end, so it looks 
% one line ahead: it holds a line back until the next one comes, which is 
% enough for a club and a widow penalty, but not for keeping a whole listing 
% together or three lines at each end.
% So we hold back all of them.
% We collect the lines in a |\vbox|; at the end of the listing we know how 
% many lines there are, put the penalties between them that we want, and 
% add them to the page.
%
% This is for the notes: on the slides, frames don't break, and we want 
% nothing to change there.
% So we do nothing when the class is |beamer|.
% \TeX\ skips that code as a whole, so the conditionals in it must be known 
% before.
%    \begin{macrocode}
\newcommand\@didactic@keep@ifblank[1]{%
  \@tempswatrue
  \let\@didactic@keep@scanafter\relax
  \expandafter\@didactic@keep@scan\detokenize{#1}\@empty\@nil
  \if@tempswa\expandafter\@firstoftwo\else\expandafter\@secondoftwo\fi}
\def\@didactic@keep@scannil{\relax}
\begingroup
\catcode`\|=0 \catcode`\[=1 \catcode`\]=2 \catcode`\{=12 \catcode`\}=12
\catcode`\P=12 \catcode`\Y=12 \catcode`\G=12 |catcode`|\=12
