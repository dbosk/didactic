%
% \paragraph{Contents next to a side caption.}
% |memoir| sets the contents of a float with a |sidecaption| in a |minipage| 
% as wide as the text, and the caption beside it in the margin.
% So a table narrower than the text sits at the left of the text block, and 
% with the caption in the right margin there is a gap between them.
% We want the contents next to the caption.
% They can't be flushed from inside: |memoir| typesets the contents first 
% and only then decides which margin this float's caption goes in 
% (|\m@mscapcheckside|, in |\endsidecaption|), so inside the contents 
% |\ifscapmargleft| still tells the side of the previous float, which with 
% |outer| or |inner| may be the other one.
% Instead we set the contents in a |varwidth| box, which is as wide as its 
% contents but at most as wide as the text, and place that box at the 
% caption's side of a box as wide as the text, when the side is known 
% (|\m@mscapopboxes|).
% The total width stays the same, so |memoir|'s placement of the caption 
% doesn't change, and neither does the height, which places the caption 
% vertically (|\m@mcalcscapraise|).
%
% We patch three of |memoir|'s internal macros, |\m@mscapstart@fbox|, 
% |\m@mscapend@fbox| and |\m@mscapopboxes|, which |memoir|'s other side 
% captions (|sidecontcaption|, |sidenamedlegend|, |sidelegend|) use too.
% The minipage's start and end must be replaced together, so we check that 
% all three patches apply before we apply any, and otherwise leave |memoir| 
% as it is, with a warning.
% This code is skipped without |memoir|, where |\ifscapmargleft| is 
% undefined: TeX wouldn't count it as a conditional while skipping, but 
% would count its |\else| and |\fi|, so we test it, and our own flag, with 
% |\ifbool| instead.
%    \begin{macrocode}
\IfStrEqCase{\@didactic@sidecapalign}{%
  {caption}{%
    \RequirePackage{varwidth}%
    \newcommand\@didactic@scapbox{%
      \ifbool{scapmargleft}
        {\makebox[\m@mscapmainwidth][l]{\usebox{\m@mscap@fbox}}}
        {\makebox[\m@mscapmainwidth][r]{\usebox{\m@mscap@fbox}}}}%
    \newbool{@didactic@scappatch}%
    \ifpatchable{\m@mscapstart@fbox}{\begin{minipage}[c]{\m@mscapmainwidth}}{%
      \ifpatchable{\m@mscapend@fbox}{\end{minipage}}{%
        \ifpatchable{\m@mscapopboxes}{\usebox{\m@mscap@fbox}}{%
          \booltrue{@didactic@scappatch}}{}}{}}{}%
    \ifbool{@didactic@scappatch}{%
      \patchcmd{\m@mscapstart@fbox}
        {\begin{minipage}[c]{\m@mscapmainwidth}}
        {\begin{varwidth}[c]{\m@mscapmainwidth}}{}{}%
      \patchcmd{\m@mscapend@fbox}{\end{minipage}}{\end{varwidth}}{}{}%
      \patchcmd{\m@mscapopboxes}
        {\usebox{\m@mscap@fbox}}{\@didactic@scapbox}{}{}%
    }{%
      \PackageWarningNoLine{didactic}{%
        Can't patch memoir's side captions; option\MessageBreak
        sidecapalign=caption has no effect}%
    }}
  {off}{}%
}[\PackageWarningNoLine{didactic}{%
    Unknown value `\@didactic@sidecapalign'\MessageBreak
    for sidecapalign; use caption or off}]

