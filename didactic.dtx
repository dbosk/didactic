% \begin{macro}{\@didactic@keep@first}
% \begin{macro}{\@didactic@keep@next}
% \begin{macro}{\@didactic@keep@add}
% \textsf{fancyvrb} sets the first line with |\FV@ListProcessLine@i|, which 
% also puts the label of a list item before it, if the listing starts an 
% item, and then lets |\FV@ProcessLine| be the macro for the next lines.
% We do the same, with our own macro for the next lines.
%
% The lines are collected in |\@didactic@keep@box|, in the order and with 
% the material between them that \textsf{fancyvrb} would put on the page.
% That isn't only the lines: \textsf{fvextra} adds |\vspace| of $-0.25$\,pt 
% after each line it sets (so that the backgrounds of two lines overlap), 
% even without a background colour, and \textsf{fancyvrb} sets a line in a 
% box first and puts it on the page only when the next one is set, so the 
% space comes before the line it belongs to.
% We do the same: we set the line with |\setbox| within the |\vbox|, and 
% then add it.
% When a box is added to a vertical list, \TeX\ puts the interline glue 
% before it, computed from the depth of the box before, |\prevdepth|.
% In a new |\vbox| that depth is lost, so we keep it in 
% |\@didactic@keep@pd| and restore it each time.
% For the first line it is the depth of what is on the page before the 
% listing: so the glue before the first line is the glue it would have got 
% on the page, and it comes along when we add the lines to the page.
%
% An empty line in a program shows nothing, so three lines at the foot of a 
% page of which one is empty look like two.
% We count the lines that aren't empty, in |\@didactic@keep@nb|, and note 
% for each line whether it's empty, a |1| or a |0| in front of 
% |\@didactic@keep@blanks|, so that the last line comes first.
% A line of spaces or tabs shows nothing either, but it needn't be empty as a 
% token list: \TeX\ removes the spaces at the end of a line it reads, 
% but a line from |minted| holds what the lexer gave, for some 
% lexers |\PYG{+w}{    }|.
% So |\@didactic@keep@ifblank| looks at the line as a string, and takes it as 
% empty if it holds nothing else than white space and |\PYG| around white 
% space.
% (A line that holds only something else invisible, like the |\label| of 
% |escapeinside|, counts as a line: we can't tell what a command does.)
% We do this for every line, so it must be cheap: a regular expression took some 
% 9\,ms a line, which a listing of 1500 lines feels.
% So we read the string from the front: a character below 14 is white space, a 
% backslash must start |\PYG {class}{text}|, whose text we read the same way, and 
% anything else ends it.
% Nearly all lines tell at their first or second word.
% In the string all characters but the space have category 12, so the letters and
% braces in the delimiters below must too.
%    \begin{macrocode}
\newbox\@didactic@keep@box
\newbox\@didactic@keep@line
\newbox\@didactic@keep@labels
\newcount\@didactic@keep@n
\newcount\@didactic@keep@nb
\newdimen\@didactic@keep@pd
\def\@didactic@keep@first#1{%
  \@didactic@keep@atfirst
  \setbox\@didactic@keep@labels\box\@labels
  \global\@didactic@keep@n\z@
  \global\@didactic@keep@nb\z@
  \gdef\@didactic@keep@blanks{}%
  \ifvmode
    \global\@didactic@keep@pd\prevdepth
  \else
    \global\@didactic@keep@pd-\@m\p@
  \fi
  \global\setbox\@didactic@keep@box\vbox{%
    \prevdepth\@didactic@keep@pd
    \hbox{%
      \ifvoid\@didactic@keep@labels\else
        \hbox to\z@{\kern\@totalleftmargin\box\@didactic@keep@labels\hss}%
      \fi
      \FV@ListProcessLine{#1}}%
    \global\@didactic@keep@pd\prevdepth}%
  \@didactic@keep@add{#1}%
  \let\FV@ProcessLine\@didactic@keep@next}
\def\@didactic@keep@next#1{%
  \global\setbox\@didactic@keep@box\vbox{%
    \unvbox\@didactic@keep@box
    \setbox\@didactic@keep@line\FV@ListProcessLine{#1}%
    \prevdepth\@didactic@keep@pd
    \box\@didactic@keep@line
    \global\@didactic@keep@pd\prevdepth}%
  \@didactic@keep@add{#1}}
\def\@didactic@keep@add#1{%
  \global\advance\@didactic@keep@n\@ne
  \@didactic@keep@ifblank{#1}{%
    \xdef\@didactic@keep@blanks{1\@didactic@keep@blanks}%
  }{%
    \global\advance\@didactic@keep@nb\@ne
    \xdef\@didactic@keep@blanks{0\@didactic@keep@blanks}%
  }}
%    \end{macrocode}
% \end{macro}
