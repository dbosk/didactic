% |\chapter| use too, or a page that is empty before the next paragraph starts; 
% \TeX\ ends a page when something doesn't fit on it, and that paragraph isn't 
% there yet.
% The macros don't touch the scratch registers: they run wherever a paragraph 
% starts, say in the body of a |\loop| of someone else.
% For the same reason the list of penalties is built by expansion.
%    \begin{macrocode}
