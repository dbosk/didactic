% \begin{macro}{\@didactic@keep@penalty}
% The penalty after line~|#1| of the |\@didactic@keep@n| lines, when 
% |\@didactic@keep@tail| of the lines after it aren't empty, and the one 
% right after it is empty if |\@didactic@keep@nextblank| is |1|.
% We start from what \textsf{fancyvrb} puts there: |\interlinepenalty|, 
% plus |\clubpenalty| after the first line and |\widowpenalty| before the 
% last.
% Then we forbid the break, with a penalty of 10\,000, everywhere in a 
% listing of at most |keeplines| lines, unless moving it would leave too much 
% empty space (|\if@didactic@keep@long|, see |\@didactic@keep@gap|).
% In a longer one we forbid it where fewer than |keepends| lines that aren't 
% empty come before it or after it, and before an empty line, so that no 
% page starts with one; a break after an empty line, between two parts of 
% a program, stays allowed.
% Whatever we want, the lines we forbid to break must fit on a page.
% So we add up the lines since the last break we allow, from the last line, 
% in |\@didactic@keep@run|; the rules below don't guarantee it for lines that 
% wrap, so if line~|#1| wouldn't fit with them, we allow this break, with
% \textsf{fancyvrb}'s penalty unless that forbids it too (|samepage|), and 
% say so.
% The result goes to |\@didactic@keep@pen|.
%
% In |multicols| we leave the penalties to \textsf{fancyvrb} (see 
% |\@didactic@keep@atfirst|).
%    \begin{macrocode}
\newcount\@didactic@keep@pen
\newdimen\@didactic@keep@run
\newdimen\@didactic@keep@lineht
\newdimen\@didactic@keep@maxrun
\def\@didactic@keep@penalty#1{%
  \@tempcntb\interlinepenalty
  \ifnum#1=\@ne
    \advance\@tempcntb\clubpenalty
  \fi
  \ifnum#1=\numexpr\@didactic@keep@n-\@ne\relax
    \advance\@tempcntb\widowpenalty
  \fi
  \count@\@tempcntb
  \if@didactic@keep@cols
  \else\if@didactic@keep@long
    \ifnum\numexpr\@didactic@keep@nb-\@didactic@keep@tail\relax
        <\@didactic@keepends
      \@tempcntb\@M
    \fi
    \ifnum\@didactic@keep@tail<\@didactic@keepends
      \@tempcntb\@M
    \fi
    \if1\@didactic@keep@nextblank
      \@tempcntb\@M
    \fi
  \else
    \@tempcntb\@M
  \fi\fi
  \ifnum\@tempcntb<\@M
    \global\@didactic@keep@run\z@
  \else
    \ifdim\dimexpr\@didactic@keep@run+\@didactic@keep@lineht\relax
        >\@didactic@keep@maxrun
      \@tempcntb\ifnum\count@<\@M\count@\else\z@\fi
      \global\@didactic@keep@run\z@
      \if@didactic@keep@watch\else\global\@didactic@keep@warnedtrue\fi
      \if@didactic@keep@warned\else
        \global\@didactic@keep@warnedtrue
        \PackageWarningNoLine{didactic}{%
          A listing of \the\@didactic@keep@n\space lines can't keep lines
          together\MessageBreak
          as keepends asks: they don't fit on a page.\MessageBreak
          It breaks between them, \@didactic@keep@place}%
      \fi
    \fi
  \fi
  \global\@didactic@keep@pen\@tempcntb}
%    \end{macrocode}
% \end{macro}
