%
% \subsection{Some useful PythonTeX functions}\label{PythonTeXdidactic}
%
% We want to provide some useful functions that can be used from PythonTeX.
% Particularly, we want it to generate code listings and run Python code and 
% then typeset them using |minted|.
% For instance, we want to be able to typeset the source code of a Python 
% function and then run it and typeset the output.
% We want to typeset the output from |pydoc| for a particular function or 
% module.
%
% We will create a few functions in PythonTeX, in the default session.
% These can then be used later.
% They are all prefixed with |didactic_| to avoid name clashes.
%
% The |minted| and |pythontex| environments can't be used in other functions.
% The design here is to work around that.
%    \begin{macrocode}
\begin{pycode}
import hashlib
import importlib.util
import inspect
import os
import pathlib
import re
import shlex
import signal
import sys
import subprocess
import tempfile
import time
\end{pycode}
%    \end{macrocode}
%
% Running a program in a pseudo-terminal (see below) needs a few modules that 
% only exist on POSIX systems.
% Where they are missing, we fall back to running the program through a pipe.
%    \begin{macrocode}
\begin{pycode}
try:
  import fcntl
  import pty
  import select
  import struct
  import termios
  DIDACTIC_HAVE_PTY = True
except ImportError:
  DIDACTIC_HAVE_PTY = False
\end{pycode}
%    \end{macrocode}
%
% The function |didactic_mint| typesets a text using |minted|.
% Since we can't use the |minted| environments from inside a Python function, 
% we write the text to a file and print a command that inputs it, which 
% PythonTeX then typesets for us.
% The file is named by a hash of its contents.
% This way a rerun overwrites the same file instead of leaving a new one
% behind every time.
% We also register the file with PythonTeX, so that it is removed when the
% code is rerun.
%
% Code in the document may change the working directory of PythonTeX, for
% instance to read files relative to an included part of a book.
% So we don't rely on the working directory staying put.
% We remember the directory PythonTeX started in, which is where \LaTeX{}
% looks for the files we write, and always write there.
% And we give PythonTeX absolute paths, since it resolves relative ones from
% the directory it started in, not from the current one.
%
% \begin{macro}{\didacticinputminted}
% The file must also be found by |minted| where the output is typeset.
% With the \textsf{import} package loaded, |minted| (from version~3) reads
% |\inputminted{text}{file}| as a file relative to the directory being
% imported, so that |\lstexample| in an imported part finds its programs.
% But our files are in the directory PythonTeX started in, whatever is being
% imported.
% So we print |\didacticinputminted|, which takes the same arguments as
% |\inputminted| but empties the import path while reading the file.
%    \begin{macrocode}
\NewDocumentCommand{\didacticinputminted}{O{} m m}{%
  \begingroup
    \let\import@path\@empty
    \inputminted[#1]{#2}{#3}%
  \endgroup
}
%    \end{macrocode}
% \end{macro}
%
%    \begin{macrocode}
\begin{pycode}
DIDACTIC_WORKDIR = os.getcwd()

def didactic_write_file(content, /, prefix, suffix):
  """
  Write `content` to a file named by `prefix`, a hash of the content and
  `suffix`, in the directory PythonTeX started in (`DIDACTIC_WORKDIR`).
  Register the file with PythonTeX as a created file, so that it is cleaned
  up. Return the file name, relative to that directory.
  """
  digest = hashlib.sha256(content.encode("utf-8")).hexdigest()[:16]
  filename = f"{prefix}{digest}{suffix}"
  path = os.path.join(DIDACTIC_WORKDIR, filename)
  with open(path, "w", encoding="utf-8") as f:
    f.write(content)
  didactic_track("created", path)
  return filename

def didactic_track(kind, /, *paths):
  """
  Tell PythonTeX about files: `kind` is "created" for files we write, so that
  PythonTeX cleans them up, or "dependencies" for files we read, so that
  PythonTeX reruns the code when they change. Relative paths are relative to
  the current working directory.
  """
  try:
    getattr(pytex, f"add_{kind}")(*(os.path.abspath(p) for p in paths))
  except NameError:
    pass

def didactic_resolve(basedir, path):
  """
  Resolve `path` against `basedir`. A relative `basedir` is relative to the
  directory PythonTeX started in (`DIDACTIC_WORKDIR`), so it doesn't matter
  whether the working directory has been changed. Without a `basedir`, or
  for an absolute `path`, return `path` unchanged.
  """
  if basedir is None or path is None or os.path.isabs(path):
    return path
  return os.path.join(DIDACTIC_WORKDIR, basedir, path)

def didactic_mint(output, /, lang="text",
                  minted_opts="escapeinside=||",
                  fullwidth=False, hlgrep=None):
  """
  Typeset the output using minted.

  - `lang` is the language of the output.
  - `minted_opts` are options to pass to minted. The default is to escape 
  inside the code using |...|.
  - `fullwidth` is a boolean to wrap the minted environment in a fullwidth 
  environment and blocks the margin. False by default.
  - `hlgrep` is a list of patterns to highlight in the output. Every line that 
  matches one of the patterns will be highlighted.
  """
  if fullwidth:
    print(r"\csname @didactic@beginfullcode\endcsname")

  if not minted_opts:
    minted_opts = ""
  if hlgrep:
    highlightlines = []
    for i, line in enumerate(output.splitlines()):
      for pattern in hlgrep:
        if re.search(pattern, line):
          highlightlines.append(i+1)
          break
    hl_opt = f",highlightlines={{{','.join(str(i) for i in highlightlines)}}}"
    if minted_opts:
      minted_opts += f",{hl_opt}"
    else:
      minted_opts = hl_opt

  filename = didactic_write_file(output.strip("\n"),
                                 "didactic_output_", ".txt")

  if minted_opts:
    print(r"\didacticinputminted[%s]{%s}{%s}" % (minted_opts, lang, filename))
  else:
    print(r"\didacticinputminted{%s}{%s}" % (lang, filename))

  if fullwidth:
    print(r"\csname @didactic@endfullcode\endcsname")
\end{pycode}
%    \end{macrocode}
%
% Now we turn to running programs.
% There are two ways to feed a program its input, and they look different on 
% paper.
% Through a pipe, the program gets its input without anyone typing it: a 
% program that asks |Antal personer: | and reads |4| prints the prompt, but 
% nothing prints the |4| or the newline after it.
% Both come from the terminal, not from the program.
% So the output reads |Antal personer: 3.0 ägg|, which is not what a student 
% sees.
% To show what a student sees, we must run the program in a pseudo-terminal: 
% then the program sees a terminal, and the terminal echoes what we type.
% The pipe is still right for programs that read data rather than answers, 
% and it is faster, so it remains the default.
%
% Programs behave differently in a terminal in other ways too.
% Python, from version 3.13, colours its tracebacks when it writes to a 
% terminal, which would put escape codes in our listing.
% We turn colours off in the environment of the program and, since not every 
% program obeys, also strip any escape sequences from the text we capture.
% We also turn off Python's output buffering, so that output to stdout and 
% stderr are interleaved in the order they were written, and force UTF-8, 
% since we can't be sure of the locale that the build runs in.
%    \begin{macrocode}
\begin{pycode}
DIDACTIC_ENV = {"TERM": "dumb", "NO_COLOR": "1", "PYTHON_COLORS": "0",
                "PYTHONUNBUFFERED": "1", "PYTHONUTF8": "1",
                "PYTHONIOENCODING": "utf-8"}

DIDACTIC_ANSI = re.compile(
  r"\x1b\[[0-?]*[ -/]*[@-~]"              # CSI sequences (colours, cursor)
  r"|\x1b\][^\x07\x1b]*(?:\x07|\x1b\\)"   # OSC sequences (titles, links)
  r"|\x1b[@-Z\\-_]")                      # other two-byte escapes
\end{pycode}
%    \end{macrocode}
%
% A program that never terminates must not hang the build.
% We run every program in its own process group and, when the deadline 
% passes, kill the whole group.
% Killing only the direct child is not enough: with |shell=True| the child is 
% a shell, and killing it leaves the members of a pipeline running.
% We keep the output produced so far, since that is what shows where the 
% program got stuck.
%    \begin{macrocode}
\begin{pycode}
def didactic_killpg(proc):
  """Kill the whole process group of `proc`, ignoring if already gone."""
  try:
    os.killpg(os.getpgid(proc.pid), signal.SIGKILL)
  except (ProcessLookupError, PermissionError):
    pass

def didactic_pipe_run(cmd, shell, data, cwd, timeout, env):
  """Run `cmd` with `data` on a pipe; return (bytes, timed_out)."""
  proc = subprocess.Popen(cmd, shell=shell, cwd=cwd, env=env,
                          stdin=subprocess.PIPE,
                          stdout=subprocess.PIPE,
                          stderr=subprocess.STDOUT,
                          start_new_session=True)
  try:
    out, _ = proc.communicate(input=data, timeout=timeout)
    return out, False
  except subprocess.TimeoutExpired:
    didactic_killpg(proc)
    out, _ = proc.communicate()
    return out, True
\end{pycode}
%    \end{macrocode}
%
% The pseudo-terminal version has to decide \emph{when} to type each line of 
% input.
% Waiting for silence is the obvious rule: when the program has printed 
% nothing for a while, it is probably waiting for us.
% But a program that imports a slow library before it asks its question is 
% silent while importing.
% If we type then, the terminal echoes our answer at once and the prompt 
% appears after it, so the transcript is wrong and nothing warns us.
% Hence each input line may come with an |expect| text: we type the line 
% when that text has appeared in the output since we last typed.
% This is what the |expect| tool does, and for teaching examples the prompt 
% is always known.
%
% After the last line, we send end-of-file, so that a program reading all of 
% its input terminates.
% A program that asks for more than we gave then gets end-of-file, which is 
% exactly what the student would see after pressing Ctrl-D.
% The loop ends when the program has exited and its output is drained, or 
% when the deadline passes.
%    \begin{macrocode}
\begin{pycode}
def didactic_pty_run(cmd, shell, lines, expect, cwd, echo,
                     timeout, idle, eof, env, size):
  """Run `cmd` under a pseudo-terminal; return (bytes, timed_out)."""
  master, slave = pty.openpty()
  fcntl.ioctl(slave, termios.TIOCSWINSZ,
              struct.pack("HHHH", size[1], size[0], 0, 0))
  if not echo:
    attrs = termios.tcgetattr(slave)
    attrs[3] &= ~termios.ECHO
    termios.tcsetattr(slave, termios.TCSANOW, attrs)
  proc = subprocess.Popen(cmd, shell=shell, cwd=cwd, env=env,
                          stdin=slave, stdout=slave, stderr=slave,
                          start_new_session=True, close_fds=True)
  os.close(slave)

  out = b""
  pending = list(zip(lines, expect))
  scan_from = 0
  deadline = time.monotonic() + timeout
  last_activity = time.monotonic()
  eof_sent = False
  timed_out = False
  exited_at = None

  def type_line(line):
    nonlocal scan_from, last_activity
    os.write(master, line.encode("utf-8") + b"\n")
    pending.pop(0)
    scan_from = len(out)
    last_activity = time.monotonic()

  while True:
    now = time.monotonic()
    if now >= deadline:
      timed_out = True
      break
    ready, _, _ = select.select([master], [], [], min(0.05, deadline - now))
    if master in ready:
      try:
        chunk = os.read(master, 65536)
      except OSError:
        break
      if not chunk:
        break
      out += chunk
      last_activity = time.monotonic()
      continue
    if proc.poll() is not None:
      if exited_at is None:
        exited_at = now
      elif now - exited_at > 0.5:
        break
      continue
    quiet = now - last_activity
    if pending:
      line, pattern = pending[0]
      if pattern is not None:
        if pattern.encode("utf-8") in out[scan_from:]:
          type_line(line)
      elif quiet >= idle:
        type_line(line)
    elif eof and not eof_sent and quiet >= idle:
      os.write(master, b"\x04")
      eof_sent = True
      last_activity = now

  if timed_out:
    didactic_killpg(proc)
    try:
      while True:
        ready, _, _ = select.select([master], [], [], 0.2)
        if master not in ready:
          break
        chunk = os.read(master, 65536)
        if not chunk:
          break
        out += chunk
    except OSError:
      pass
  proc.wait()
  os.close(master)
  return out, timed_out
\end{pycode}
%    \end{macrocode}
%
% The function |didactic_capture| ties the two together and returns the 
% output as text.
% We normalise the line endings that a terminal produces, strip escape 
% sequences, and remove the absolute path of the directory we ran in, so that 
% a traceback reads |File "ask.py"| and not the path on the author's machine.
%    \begin{macrocode}
\begin{pycode}
def didactic_capture(cmd, /, *, shell=False, stdin=None, cwd=None,
                     tty=False, echo=True, expect=None,
                     timeout=10, idle=0.5, eof=True, env=None,
                     size=(80, 24)):
  """
  Run `cmd` and return its combined stdout and stderr as text.

  - `cmd` is a list, or a string when `shell` is True.
  - `stdin` is a list of lines (without newlines) or a string of raw input.
  - `cwd` is the directory to run in (the default is the working directory).
  - `tty` runs the command under a pseudo-terminal: the program sees a 
  terminal, and the terminal echoes what we type. Through a pipe, a prompt 
  and its answer never appear together.
  - `echo` turns the terminal's echo of what we type off if False.
  - `expect` is a list of strings parallel to `stdin`: type that line as soon 
  as the string has appeared in the output. `None` means to type it after 
  `idle` seconds of silence instead. Only used with `tty`.
  - `eof` sends end-of-file after the last line, so a program reading all of 
  its input terminates.
  - `timeout` is the deadline in seconds. On expiry the process group is 
  killed, the output so far is kept and a note is appended.
  - `env` extends the environment. Colours and buffering are turned off by 
  default, see `DIDACTIC_ENV`.
  - `size` is the (columns, rows) of the pseudo-terminal.
  """
  full_env = dict(os.environ)
  full_env.update(DIDACTIC_ENV)
  if env:
    full_env.update(env)

  if stdin is None:
    lines = []
    data = b""
  elif isinstance(stdin, str):
    lines = stdin.splitlines()
    data = stdin.encode("utf-8")
  else:
    lines = [str(line) for line in stdin]
    data = "".join(line + "\n" for line in lines).encode("utf-8")

  if expect is None:
    expect = []
  elif isinstance(expect, str):
    expect = [expect]
  expect = list(expect) + [None] * (len(lines) - len(expect))

  if tty and not DIDACTIC_HAVE_PTY:
    print("didactic: no pseudo-terminal support here, using a pipe",
          file=sys.stderr)
    tty = False

  if tty:
    out, timed_out = didactic_pty_run(cmd, shell, lines, expect, cwd, echo,
                                      timeout, idle, eof, full_env, size)
  else:
    out, timed_out = didactic_pipe_run(cmd, shell, data, cwd, timeout,
                                       full_env)

  text = out.decode("utf-8", errors="replace")
  text = text.replace("\r\n", "\n").replace("\r", "\n")
  text = DIDACTIC_ANSI.sub("", text)
  text = text.replace(os.path.abspath(cwd or os.curdir) + os.sep, "")
  if timed_out:
    print(f"didactic: {cmd!r} timed out after {timeout} s", file=sys.stderr)
    text = text.rstrip("\n") + f"\n[didactic: timed out after {timeout} s]"
  return text
\end{pycode}
%    \end{macrocode}
%
% The function |didactic_shell| runs a command and typesets the output.
% It is used directly from PythonTeX in documents, so its first arguments 
% keep their meaning, and everything new is a keyword argument.
% The |transcript| argument turns on the pseudo-terminal and the command line 
% at the top, so the whole looks like a terminal session.
% The command line shown is the command we run, unless |commandtext| says 
% otherwise; that lets the author run |/usr/bin/python3 -X utf8 ask.py| but 
% show |python3 ask.py|.
% When we show the command line, we drop |minted|'s default escape 
% characters, since a pipe in the command would otherwise start an escape.
%
% The run's dependencies are registered with PythonTeX.
% This matters: PythonTeX reruns code when the \emph{code} changes, and the 
% call in the document doesn't change when the program does.
% Note that we pass the directory to run in to |subprocess| and never change
% the working directory of PythonTeX itself.
%
% When a document includes parts from other directories, say the chapters
% of a book, each part refers to its programs relative to its own directory.
% The |basedir| argument is that directory.
% Relative paths are resolved against it, and the program is run there, but
% the command is left as it is.
% So the command line shown is the one written in the part, the same as when
% the part is compiled on its own.
% A relative |basedir| is taken from the directory PythonTeX started in,
% which is the directory of the main document, the same as the paths of the
% \textsf{import} package.
%    \begin{macrocode}
\begin{pycode}
def didactic_shell(cmd, /, shell=False, *, stdin=None, stdinfile=None,
                   cwd=None, tty=False, echo=True, expect=None,
                   timeout=10, idle=0.5, eof=True, env=None,
                   transcript=False, showcommand=None, commandtext=None,
                   prompt="$ ", deps=(), chdir=False, basedir=None,
                   **kwargs):
  """
  Run a command and typeset the output using minted.

  - `cmd` is the command to run, a list, or a string if `shell` is True.
  - `stdin` is a list of lines to feed the program, or a string of raw 
  input. `stdinfile` names a file whose contents are used instead.
  - `transcript` shows the run as a terminal session: sets `tty` and 
  `showcommand`. See `didactic_capture` for `tty`, `echo`, `expect`, 
  `timeout`, `idle`, `eof`, `env` and `cwd`.
  - `showcommand` prepends the command line; `commandtext` is the text to 
  show instead of the actual command; `prompt` is put in front of it.
  - `deps` are files that PythonTeX should rerun this code for when they 
  change, relative to the working directory.
  - `basedir` is the directory that relative paths (`cwd`, `stdinfile`, 
  `deps`) are relative to, and the directory to run in when `cwd` isn't 
  given. A relative `basedir` is relative to `DIDACTIC_WORKDIR`. The command 
  itself is run and shown as it is.
  - `chdir` is accepted for symmetry with `didactic_output` but has no 
  meaning here: use `cwd`.
  - `kwargs` are passed to `didactic_mint`, see that function for more 
  information.
  """
  if transcript:
    tty = True
    if showcommand is None:
      showcommand = True

  if basedir is not None:
    cwd = didactic_resolve(basedir, cwd or os.curdir)
    stdinfile = didactic_resolve(basedir, stdinfile)
    deps = [didactic_resolve(basedir, dep) for dep in deps]

  if stdinfile:
    didactic_track("dependencies", stdinfile)
    with open(stdinfile, encoding="utf-8") as f:
      stdin = f.read()
  if deps:
    didactic_track("dependencies", *deps)

  text = didactic_capture(cmd, shell=shell, stdin=stdin, cwd=cwd, tty=tty,
                          echo=echo, expect=expect, timeout=timeout,
                          idle=idle, eof=eof, env=env)

  if showcommand:
    if commandtext is None:
      commandtext = (cmd if isinstance(cmd, str)
                     else " ".join(didactic_quote(arg) for arg in cmd))
    text = prompt + commandtext + "\n" + text
    kwargs.setdefault("minted_opts", "")

  didactic_mint(text.strip("\n"), **kwargs)
\end{pycode}
%    \end{macrocode}
%
% The command line we show should read as the student would type it.
% |shlex.join| quotes every argument with a character outside a small ASCII 
% set, so |python3 greet.py Åsa| would read |python3 greet.py 'Åsa'|.
% We quote only what the shell needs quoted: an argument of letters, in any 
% alphabet, digits and |@%+=:,./-| is left as it is, just as |shlex.quote| 
% leaves such ASCII arguments; anything else is quoted by |shlex.quote|.
%    \begin{macrocode}
\begin{pycode}
def didactic_quote(arg, /):
  """
  Quote `arg` for a command line shown to the reader: as `shlex.quote`, but
  leave words of letters in any alphabet unquoted, e.g. `två`.
  """
  if re.fullmatch(r"[\w@%+=:,./-]+", arg):
    return arg
  return shlex.quote(arg)
\end{pycode}
%    \end{macrocode}
%
% The function |didactic_output| runs a Python program.
% With |chdir|, we run the program from its own directory and give the 
% interpreter only the file name, so that the command line reads 
% |python3 ask.py| and not |python3 examples/ask.py|: this is what the student 
% types in that directory.
% The program is always registered as a dependency, so that a changed 
% program is rerun.
%    \begin{macrocode}
\begin{pycode}
def didactic_output(module, /, interpreter="python3", *, args=None,
                    chdir=False, cwd=None, deps=(), track=True,
                    basedir=None, **kwargs):
  """
  Run a Python program and typeset the output using minted.

  - `module` is anything that can be passed as an argument to the Python 
  interpreter. Usually a file name or a module name.
  - `interpreter` is the Python interpreter to use. The default is `python3`. 
  It may contain options, like `python3 -X utf8`.
  - `args` are the command-line arguments to the program, a string that is 
  split like a shell does, or a list.
  - `chdir` runs the program from its own directory, so that the command 
  line shown in a transcript is the short one. An explicit `cwd` wins.
  - `deps` are additional files that the run depends on. The program itself 
  is always a dependency, unless `track` is False.
  - `basedir` is the directory that the paths are relative to and that the 
  program is run from, see `didactic_shell`. The command line shows the 
  program as given.
  - `kwargs` are passed to `didactic_shell`, see that function for more 
  information.
  """
  path = didactic_resolve(basedir, module)
  if track and os.path.isfile(path):
    didactic_track("dependencies", path)
  argv = shlex.split(args) if isinstance(args, str) else list(args or [])
  interp = (shlex.split(interpreter) if isinstance(interpreter, str)
            else list(interpreter))
  if chdir:
    directory, name = os.path.split(module)
    if cwd is None:
      cwd = directory or None
    module = name
  didactic_shell(interp + [module] + argv, cwd=cwd, deps=deps,
                 basedir=basedir, **kwargs)

def didactic_pydoc(module, /, builtin=False, **kwargs):
  """
  Print the pydoc for a module.

  If `builtin` is True, print the pydoc for a builtin module. For non-built in 
  modules, pydoc adds a few lines of paths to the module. We don't want that, 
  so we cut those lines. For built-ins, however, it doesn't print those lines, 
  so we shouldn't cut any lines in that case.

  The `kwargs` are passed to `didactic_mint`, see that function for more 
  information.
  """
  output = subprocess.run(["python3", "-m", "pydoc", module],
                          capture_output=True)
  lines = output.stdout.decode().splitlines()
  if not builtin:
    lines = lines[:-4]
  didactic_mint("\n".join(lines).strip("\n"), lang="text", **kwargs)

def didactic_help(module, /, **kwargs):
  """
  Print the help for a module.

  The `kwargs` are passed to `didactic_mint`, see that function for more 
  information.
  """
  didactic_mint(help(module), **kwargs)

def didactic_source(function, /, **kwargs):
  """
  Print the source code of a function. This is a function object and we use 
  inspection to get the source code of the actual Python function object.

  The `kwargs` are passed to `didactic_mint`, see that function for more 
  information.
  """
  didactic_mint(inspect.getsource(function).strip("\n"), lang="python", 
  **kwargs)

def didactic_import(module_name, module_path):
  """
  Import a module named `module_name` from a path `module_path`. This is useful 
  when we want to import a module that is not in the current directory. This 
  might be the case with PythonTeX, when it runs in a subdirectory and we want 
  to import a module that we're writing.
  """
  # from https://stackoverflow.com/a/67692/1305099
  spec = importlib.util.spec_from_file_location(module_name, module_path)
  the_module = importlib.util.module_from_spec(spec)
  sys.modules[module_name] = the_module
  spec.loader.exec_module(the_module)
  return the_module
\end{pycode}
%    \end{macrocode}
%
% Finally, |didactic_run_code| runs code given as a string by writing it to a 
% file.
% That file is created by us, so we don't register it as a dependency: its 
% modification time changes whenever the code is rerun, which would make 
% PythonTeX rerun the code once more.
%    \begin{macrocode}
\begin{pycode}
def didactic_run_code(code, /, **kwargs):
  """
  Run a Python program and typeset the output using minted. The `code` is 
  Python code, not a file name. This function simply writes the code to a file 
  and then runs it using `didactic_output`.

  - `kwargs` are passed to `didactic_output`, which in turn passes some 
  arguments on to `didactic_mint`. See those functions for details.
  """
  filename = didactic_write_file(code, "didactic_code_", ".py")
  didactic_output(filename, track=False, **kwargs)
\end{pycode}
%    \end{macrocode}
%
% \subsection{Extracting code and setting it side by side}
%
% To show a function in a program, we have |didactic_source|, which takes 
% the function itself, and |didactic_import| to get it: it imports the 
% program.
% That runs the program, which is safe only when the program calls its |main| 
% under the |__name__| guard.
% Programs written before that guard is taught call |main()| directly, and 
% importing one runs it, with its |input()| and all, during the build.
% So we also read programs as text and cut out what we want with the |ast| 
% module, which never runs anything.
% |didactic_extract| cuts out a function or class by name (with dots for a 
% method in a class, |"Person.__eq__"|), a range of lines, or the lines from 
% one text to another.
% The text to end at must be indented no more than the text to start at, so 
% that |from="phonebook = {"| and |to="}"| take the whole dictionary and not 
% the first of its inner dictionaries to end.
% The program is a dependency, so a changed program is extracted again.
%    \begin{macrocode}
\begin{pycode}
import ast
import textwrap

def didactic_find_def(tree, name):
  """
  Return the node of the function or class `name` in the `ast` tree; a dotted 
  name goes into classes, e.g. "Person.__eq__".
  """
  nodes = tree.body
  node = None
  for part in name.split("."):
    node = next((n for n in nodes
                 if isinstance(n, (ast.FunctionDef, ast.AsyncFunctionDef,
                                   ast.ClassDef))
                 and n.name == part), None)
    if node is None:
      raise ValueError(f"didactic_extract: no def or class {name!r}")
    nodes = node.body
  return node

def didactic_docstring_lines(node):
  """
  Return the line numbers of the docstring of `node`, if any. A docstring 
  that shares a line with other code (the def line, or a statement after it 
  on its last line) is kept: we drop whole lines only.
  """
  body = getattr(node, "body", [])
  if (body and isinstance(body[0], ast.Expr)
      and isinstance(body[0].value, ast.Constant)
      and isinstance(body[0].value.value, str)):
    doc = body[0]
    if getattr(node, "lineno", None) == doc.lineno:
      return set()
    if len(body) > 1 and body[1].lineno == doc.end_lineno:
      return set()
    return set(range(doc.lineno, doc.end_lineno + 1))
  return set()

def didactic_line_matches(line, pattern):
  """Whether `line` matches `pattern`, a string (substring) or a regex."""
  if isinstance(pattern, str):
    return pattern in line
  return pattern.search(line) is not None

def didactic_extract(path, /, name=None, *, lines=None, between=None,
                     strip_docstring=False, basedir=None):
  """
  Return a part of the program in `path` as text, without importing or 
  running it.

  - `name` cuts out a function or class, with its decorators; a dotted name 
  goes into a class, e.g. "Person.__eq__".
  - `lines` is a range of line numbers, (first, last) or "first-last", 
  counting from 1 and including both, or a single number.
  - `between` is (start, end): the lines from the first line matching start 
  to the first line after it that matches end and is indented no more than 
  the start line. Each is a string (to be contained in the line) or a 
  compiled regex. With end None, to the end of the block that start begins 
  (the line before the next line indented no more than it).
  - `strip_docstring` drops the docstring of the def, class or module.
  - `basedir` is the directory that `path` is relative to, see 
  `didactic_shell`.
  Without any of these, the whole program. The text is dedented.
  """
  path = didactic_resolve(basedir, path)
  didactic_track("dependencies", path)
  with open(path, encoding="utf-8") as f:
    source = f.read()
  all_lines = source.splitlines()
  numbers = list(range(1, len(all_lines) + 1))
  drop = set()
  if name is not None:
    node = didactic_find_def(ast.parse(source, filename=path), name)
    first = min([node.lineno] + [d.lineno for d in node.decorator_list])
    numbers = list(range(first, node.end_lineno + 1))
    if strip_docstring:
      drop = didactic_docstring_lines(node)
  else:
    if strip_docstring:
      drop = didactic_docstring_lines(ast.parse(source, filename=path))
    if lines is not None:
      if isinstance(lines, int):
        first = last = lines
      elif isinstance(lines, str):
        parts = [int(n) for n in lines.split("-")]
        first, last = parts[0], parts[-1]
      else:
        first, last = lines
      numbers = list(range(first, last + 1))
    elif between is not None:
      start, end = between
      first = next((i for i, line in enumerate(all_lines, 1)
                    if didactic_line_matches(line, start)), None)
      start_end = None
      if first is not None:
        line = all_lines[first-1]
        if isinstance(start, str):
          start_end = line.index(start) + len(start)
        else:
          start_end = start.search(line).end()
      if first is None:
        raise ValueError(f"didactic_extract: no line with {start!r}")
      indent = len(all_lines[first-1]) - len(all_lines[first-1].lstrip())
      def indent_of(i):
        return len(all_lines[i-1]) - len(all_lines[i-1].lstrip())
      if end is None:
        # to the end of the block: before the next line indented no more
        after = next((i for i in range(first + 1, len(all_lines) + 1)
                      if all_lines[i-1].strip() and indent_of(i) <= indent),
                     len(all_lines) + 1)
        last = after - 1
        while last > first and not all_lines[last-1].strip():
          last -= 1
      elif didactic_line_matches(all_lines[first-1][start_end:], end):
        # the end is on the start line, after the start
        last = first
      else:
        last = next((i for i in range(first + 1, len(all_lines) + 1)
                     if didactic_line_matches(all_lines[i-1], end)
                     and indent_of(i) <= indent), None)
      if last is None:
        raise ValueError(f"didactic_extract: no line with {end!r} "
                         f"after {start!r}")
      numbers = list(range(first, last + 1))
  if drop and max(drop) + 1 in numbers and not all_lines[max(drop)].strip():
    drop.add(max(drop) + 1)
  text = "\n".join(all_lines[i-1] for i in numbers if i not in drop)
  return textwrap.dedent(text).strip("\n")
\end{pycode}
%    \end{macrocode}
%
% |didactic_pair| sets two or more pieces of code side by side, each in its 
% own column.
% The columns are as wide as their longest lines need, in proportion, unless 
% |widths| says otherwise, and they fill the line: in article mode the full 
% width, margin included (see the |didacticpair| environment below), on the 
% slides the frame.
% Each piece is written to a file, as in |didactic_mint|, and typeset with 
% |\didacticinputminted|; |labels| puts a label, usually the file name, 
% above each column.
%    \begin{macrocode}
\begin{pycode}
def didactic_file_label(name):
  """Return a label for `didactic_pair` showing the file `name` as is."""
  return r"\texttt{\detokenize{%s}}" % name

def didactic_pair(*sides, lang="python", langs=None, widths=None,
                  labels=None, minted_opts="", side_opts=None, hlgrep=None):
  """
  Typeset `sides`, two or more strings of code, side by side.

  - `lang` is the language of all sides, or `langs` one per side.
  - `widths` are the fractions of the line for the columns; by default they 
  are in proportion to the longest line of each side.
  - `labels` are put above the columns, None for none. They are LaTeX, so a 
  file name with an underscore needs `didactic_file_label(name)`.
  - `minted_opts` are minted options for all sides, `side_opts` one string 
  per side added to them; `hlgrep` highlights lines matching any of the 
  patterns, as in `didactic_mint`.
  """
  n = len(sides)
  if n < 2:
    raise ValueError("didactic_pair: give two or more sides")
  langs = list(langs) if langs else [lang] * n
  side_opts = list(side_opts) if side_opts else [""] * n
  for what, values in (("langs", langs), ("side_opts", side_opts),
                       ("widths", widths), ("labels", labels)):
    if values is not None and len(values) != n:
      raise ValueError(f"didactic_pair: {n} sides but {len(values)} {what}")
  if widths is None:
    longest = [max((len(line) for line in side.splitlines()), default=1)
               for side in sides]
    widths = [max(length, 1) / sum(max(l, 1) for l in longest)
              for length in longest]
  # in thousandths, the last column takes the rest so that they add up
  shares = [round(1000 * width / sum(widths)) for width in widths[:-1]]
  shares.append(1000 - sum(shares))
  colspec = r"@{\hspace{\didacticpairgap}}".join(
    r"p{\dimexpr(\linewidth-%d\didacticpairgap)*%d/1000\relax}"
    % (n - 1, share) for share in shares)
  # the document's line, for warnings: TeX reads this from a file
  try:
    line = pytex.line
  except (NameError, AttributeError):
    line = ""
  print(r"\begin{didacticpair}[line=%s]{@{}%s@{}}" % (line, colspec))
  if labels:
    print(" & ".join(r"\didacticpairlabel{%s}" % (label or "")
                     for label in labels) + r"\\")
  cells = []
  for side, side_lang, extra in zip(sides, langs, side_opts):
    options = ",".join(opt for opt in (minted_opts, extra) if opt)
    if hlgrep:
      lines = [i + 1 for i, line in enumerate(side.splitlines())
               if any(re.search(pattern, line) for pattern in hlgrep)]
      if lines:
        options = ",".join(opt for opt in (options,
          "highlightlines={%s}" % ",".join(map(str, lines))) if opt)
    filename = didactic_write_file(side, "didactic_pair_", ".txt")
    cells.append(r"\didacticinputminted[%s]{%s}{%s}"
                 % (options, side_lang, filename))
  print("\n&\n".join(cells))
  print(r"\end{didacticpair}")
\end{pycode}
%    \end{macrocode}
%
%
% \subsection{Listing and running code examples}
%
% Let's turn our focus to |\lstexample| and |\runpython|.
% We want to make it easy to typeset and print the output of example Python 
% programs in slides and texts.
% We want to use PythonTeX to automatically run the code and typeset the source 
% code using |minted|.
%
% These are the same for both |beamer| and article mode.
% \begin{example}
%   Here's a code example:
%   \lstexample{python}{hello.py}
%   And here's the output:
%   \runpython{hello.py}
% \end{example}
%
% \begin{example}\label{ExampleSideBySide}
%   Here's another code example, set side by side with its output:
%   \textbytext*
%     {Code \hrulefill\par\lstexample{python}{hello.py}}
%     {Output \hrulefill\par\runpython{hello.py}}
% \end{example}
%
% \begin{macro}{\lstexample}
% The first part is easy.
% To typeset the source file we simply need to use the minted package.
% We provide an optional argument to pass options to minted.
% We also note that we need the |marginfix| package for the |\blockmargin| and
% |\unblockmargin| commands.
% We use these together with the |fullwidth| environment to typeset the code 
% using the additional space taken from the margin notes, hence we need to also 
% block the margin.
%
% |\blockmargin| is a margin note in vertical mode, and \LaTeX\ follows such 
% a note with a place where the page may break (|\addpenalty|, in 
% |\@specialoutput|), unless |\if@nobreak| is true.
% So with the option |keepleadin|, which keeps a listing with the paragraph 
% before it, we block the margin through |\@didactic@blockmargin|, which 
% makes |\if@nobreak| true for that moment, if it isn't already.
% We can do that here because we know that a listing comes next.
% The |fullwidth| environment is a list, whose start allows a page break 
% too, so with |keepleadin| we forbid that one as well, in a group around 
% the environment: |\@didactic@beginfullcode| and |\@didactic@endfullcode|.
% The PythonTeX functions print them with |\csname|, since their output is
% read where |@| isn't a letter.
% All this only if moving them stays within |keepmaxgap|
% (|\@didactic@keep@tie|), which we can tell when the paragraph has ended; a
% listing that runs on from its paragraph stays with it.
%    \begin{macrocode}
\RequirePackage{marginfix}
\newcommand\@didactic@blockmargin{%
  \if@didactic@keepleadin
    \if@nobreak
      \blockmargin
    \else\if@didactic@keep@movable
      \@nobreaktrue
      \blockmargin
      \@nobreakfalse
    \else
      \blockmargin
    \fi\fi
  \else
    \blockmargin
  \fi}
\newcommand\@didactic@beginfullcode{%
  \ifvmode
    \@didactic@keep@tie
  \else
    \global\@didactic@keep@movabletrue
  \fi
  \@didactic@blockmargin
  \begingroup
  \@didactic@keep@notelist
  \if@didactic@keepleadin
    \if@didactic@keep@movable
      \@beginparpenalty\@M
    \fi
  \fi
  \begin{fullwidth}}
\newcommand\@didactic@endfullcode{%
  \end{fullwidth}%
  \endgroup
  \unblockmargin}
\NewDocumentCommand{\lstexample}{somm}{%
  \IfBooleanTF{#1}{\@didactic@beginfullcode}{\relax}
  \IfValueTF{#2}
    {\inputminted[escapeinside=||,#2]{#3}{#4}}
    {\inputminted[escapeinside=||]{#3}{#4}}
  \IfBooleanTF{#1}{\@didactic@endfullcode}{\relax}
}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\runpython}
% \begin{macro}{\runshell}
% \begin{macro}{\runsetup}
% \begin{macro}{\runbasedir}
% Now, for the second part, printing the output.
% We can use it like |\runpython{hello.py}| to run the program in |hello.py|.
% The output is printed in a |minted| environment.
% The optional argument is a key--value list: the keys we know control the 
% run, and the keys we don't know are passed on to |minted|.
% So |\runpython[highlightlines=1]{hello.py}| still works as it always did.
%
% The command builds one call to |didactic_output| (or |didactic_shell| for 
% |\runshell|) as a string, and hands that string to |\pyc|.
% Since |\pyc| detokenizes its argument, a string of already-detokenized 
% characters passes through unchanged.
% We work in |expl3| syntax, which has two consequences for what follows.
% Spaces in the code are ignored, so the Python call is built without spaces 
% (Python doesn't need them), and we write |~| when we mean a space.
% And |_| and |:| are letters, so they can't appear in a Python identifier 
% here; we don't need them to.
%
% We first declare the variables that hold the values of the keys.
%    \begin{macrocode}
\ExplSyntaxOn
\seq_new:N \l__didactic_stdin_seq
\seq_new:N \l__didactic_expect_seq
\tl_new:N \l__didactic_expect_tl
\tl_new:N \l__didactic_stdinfile_tl
\tl_new:N \l__didactic_args_tl
\tl_new:N \l__didactic_interpreter_tl
\tl_new:N \l__didactic_cwd_tl
\tl_new:N \l__didactic_basedir_tl
\bool_new:N \l__didactic_chdir_bool
\bool_new:N \l__didactic_tty_bool
\bool_new:N \l__didactic_echo_bool
\bool_new:N \l__didactic_showcommand_bool
\tl_new:N \l__didactic_commandtext_tl
\tl_new:N \l__didactic_prompt_tl
\tl_new:N \l__didactic_timeout_tl
\tl_new:N \l__didactic_idle_tl
\clist_new:N \l__didactic_deps_clist
\tl_new:N \l__didactic_lang_tl
\bool_new:N \l__didactic_fullwidth_bool
\bool_new:N \l__didactic_shell_bool
\clist_new:N \l__didactic_minted_clist
\clist_new:N \l__didactic_unknown_clist
\tl_new:N \g__didactic_run_defaults_tl
\str_new:N \l__didactic_call_str
\str_new:N \l__didactic_tmp_str
%    \end{macrocode}
%
% Then the keys.
% The |stdin| key can be repeated, one line of input per use, so it appends 
% to a sequence.
% The |expect| key applies to the next |stdin| line: |expect| stores the 
% text, and |stdin| moves it to a parallel sequence, with an empty entry when 
% no |expect| was given.
% The |transcript| key is a shorthand for the three keys that make a run look 
% like a terminal session.
% A value that is left empty means that the default of the Python function 
% applies, so that the defaults live in one place.
%    \begin{macrocode}
\cs_new_protected:Npn \__didactic_stdin:n #1
  {
    \seq_put_right:Nn \l__didactic_stdin_seq {#1}
    \seq_put_right:NV \l__didactic_expect_seq \l__didactic_expect_tl
    \tl_clear:N \l__didactic_expect_tl
  }
\keys_define:nn { didactic / run }
  {
    stdin       .code:n      = { \__didactic_stdin:n {#1} } ,
    expect      .tl_set:N    = \l__didactic_expect_tl ,
    stdinfile   .tl_set:N    = \l__didactic_stdinfile_tl ,
    args        .tl_set:N    = \l__didactic_args_tl ,
    interpreter .tl_set:N    = \l__didactic_interpreter_tl ,
    cwd         .tl_set:N    = \l__didactic_cwd_tl ,
    basedir     .tl_set:N    = \l__didactic_basedir_tl ,
    chdir       .bool_set:N  = \l__didactic_chdir_bool ,
    chdir       .default:n   = { true } ,
    tty         .bool_set:N  = \l__didactic_tty_bool ,
    tty         .default:n   = { true } ,
    echo        .bool_set:N  = \l__didactic_echo_bool ,
    echo        .default:n   = { true } ,
    showcommand .bool_set:N  = \l__didactic_showcommand_bool ,
    showcommand .default:n   = { true } ,
    commandtext .tl_set:N    = \l__didactic_commandtext_tl ,
    prompt      .tl_set:N    = \l__didactic_prompt_tl ,
    timeout     .tl_set:N    = \l__didactic_timeout_tl ,
    idle        .tl_set:N    = \l__didactic_idle_tl ,
    deps        .clist_set:N = \l__didactic_deps_clist ,
    lang        .tl_set:N    = \l__didactic_lang_tl ,
    fullwidth   .bool_set:N  = \l__didactic_fullwidth_bool ,
    shell       .bool_set:N  = \l__didactic_shell_bool ,
    shell       .default:n   = { true } ,
    fullwidth   .default:n   = { true } ,
    transcript  .meta:n      = { tty , showcommand , chdir } ,
    transcript  .value_forbidden:n = true ,
  }
%    \end{macrocode}
%
% Before each run we reset all values, then apply the defaults set by 
% |\runsetup|, then the keys of the call itself.
% The keys that aren't ours are collected for |minted|; 
% |\keys_set_known:nnN| does that for us, keeping braces and control 
% sequences in the values intact.
%    \begin{macrocode}
\cs_generate_variant:Nn \keys_set_known:nnN { nVN }
\cs_new_protected:Npn \__didactic_run_reset:
  {
    \seq_clear:N \l__didactic_stdin_seq
    \seq_clear:N \l__didactic_expect_seq
    \tl_clear:N \l__didactic_expect_tl
    \tl_clear:N \l__didactic_stdinfile_tl
    \tl_clear:N \l__didactic_args_tl
    \tl_clear:N \l__didactic_interpreter_tl
    \tl_clear:N \l__didactic_cwd_tl
    \bool_set_false:N \l__didactic_chdir_bool
    \bool_set_false:N \l__didactic_tty_bool
    \bool_set_true:N \l__didactic_echo_bool
    \bool_set_false:N \l__didactic_showcommand_bool
    \tl_clear:N \l__didactic_commandtext_tl
    \tl_clear:N \l__didactic_prompt_tl
    \tl_clear:N \l__didactic_timeout_tl
    \tl_clear:N \l__didactic_idle_tl
    \clist_clear:N \l__didactic_deps_clist
    \tl_clear:N \l__didactic_lang_tl
    \bool_set_false:N \l__didactic_fullwidth_bool
    \clist_clear:N \l__didactic_minted_clist
    \__didactic_run_keys:V \g__didactic_run_defaults_tl
  }
\cs_new_protected:Npn \__didactic_run_keys:n #1
  {
    \keys_set_known:nnN { didactic / run } {#1} \l__didactic_unknown_clist
    \clist_concat:NNN \l__didactic_minted_clist
      \l__didactic_minted_clist \l__didactic_unknown_clist
  }
\cs_generate_variant:Nn \__didactic_run_keys:n { V }
\NewDocumentCommand{\runsetup}{m}
  { \tl_gset:Nn \g__didactic_run_defaults_tl {#1} }
%    \end{macrocode}
%
% The base directory is not reset before each run, so that it can be set 
% for a part of the document with |\runbasedir|.
% That setting is local, so it ends with the group it's made in.
% We keep it apart from |\runsetup|, which is global and replaces all the 
% defaults: a part that sets its own defaults must not lose its base 
% directory.
% The key |basedir| still works in |\runsetup|, but then it wins over 
% |\runbasedir|, since the defaults are applied at each run.
% The value |auto| means the directory of the file that the \textsf{import} 
% package is currently reading, which we look up at each run, since 
% \textsf{import} changes it as it goes.
% Outside of an import, or without the package, that is empty, which means 
% no base directory.
%    \begin{macrocode}
\NewDocumentCommand{\runbasedir}{m}
  { \tl_set:Nn \l__didactic_basedir_tl {#1} }
\tl_const:Nn \c__didactic_auto_tl { auto }
\cs_new_protected:Npn \__didactic_basedir_resolve:
  {
    \tl_if_eq:NNT \l__didactic_basedir_tl \c__didactic_auto_tl
      {
        \cs_if_exist:cTF { import@path }
          { \tl_set_eq:Nc \l__didactic_basedir_tl { import@path } }
          { \tl_clear:N \l__didactic_basedir_tl }
      }
  }
%    \end{macrocode}
%
% Values become Python string literals.
% A backslash in a value has already become a control sequence when we see 
% it, and detokenizing gives it back with a trailing space; we escape 
% backslashes and quotes so that Python at least gets a valid string.
% Backslashes must be escaped before the quotes, or the quotes' escapes are 
% escaped again.
%    \begin{macrocode}
\str_const:Ne \c__didactic_bsbs_str { \c_backslash_str \c_backslash_str }
\str_const:Ne \c__didactic_esq_str  { \c_backslash_str ' }
\cs_generate_variant:Nn \str_replace_all:Nnn { NVV , NnV }
\cs_new_protected:Npn \__didactic_pyliteral:Nn #1#2
  {
    \str_set:Nn #1 {#2}
    \str_replace_all:NVV #1 \c_backslash_str \c__didactic_bsbs_str
    \str_replace_all:NnV #1 { ' } \c__didactic_esq_str
    \str_put_left:Nn #1 { ' }
    \str_put_right:Nn #1 { ' }
  }
\cs_generate_variant:Nn \__didactic_pyliteral:Nn { NV , Ne }
%    \end{macrocode}
%
% Three helpers append a keyword argument to the call, each only when the 
% value isn't the default: a string, a bare value (numbers) and a boolean.
%    \begin{macrocode}
\cs_new_protected:Npn \__didactic_kwarg_str:nN #1#2
  {
    \tl_if_empty:NF #2
      {
        \__didactic_pyliteral:NV \l__didactic_tmp_str #2
        \str_put_right:Nn \l__didactic_call_str { , #1 = }
        \str_put_right:NV \l__didactic_call_str \l__didactic_tmp_str
      }
  }
\cs_new_protected:Npn \__didactic_kwarg_raw:nN #1#2
  {
    \tl_if_empty:NF #2
      {
        \str_put_right:Nn \l__didactic_call_str { , #1 = }
        \str_put_right:NV \l__didactic_call_str #2
      }
  }
\cs_new_protected:Npn \__didactic_kwarg_bool:nN #1#2
  {
    \bool_if:NT #2
      { \str_put_right:Nn \l__didactic_call_str { , #1 = True } }
  }
\cs_new_protected:Npn \__didactic_kwarg_list:nN #1#2
  {
    \str_put_right:Nn \l__didactic_call_str { , #1 = [ }
    \seq_map_inline:Nn #2
      {
        \tl_if_empty:nTF {##1}
          { \str_put_right:Nn \l__didactic_call_str { None , } }
          {
            \__didactic_pyliteral:Nn \l__didactic_tmp_str {##1}
            \str_put_right:NV \l__didactic_call_str \l__didactic_tmp_str
            \str_put_right:Nn \l__didactic_call_str { , }
          }
      }
    \str_put_right:Nn \l__didactic_call_str { ] }
  }
%    \end{macrocode}
%
% Now we can build the call.
% The first argument is the Python function, the second its first argument 
% (the program or the command), and the third any extra text to append to 
% the argument list.
% The |minted| options are always passed, even when empty, so that a plain 
% |\runpython{hello.py}| typesets exactly as before.
%    \begin{macrocode}
\cs_new_protected:Npn \__didactic_run:nnn #1#2#3
  {
    \__didactic_pyliteral:Nn \l__didactic_call_str {#2}
    \str_put_left:Nn \l__didactic_call_str { #1 ( }
    \seq_if_empty:NF \l__didactic_stdin_seq
      {
        \__didactic_kwarg_list:nN { stdin } \l__didactic_stdin_seq
        \__didactic_kwarg_list:nN { expect } \l__didactic_expect_seq
      }
    \__didactic_kwarg_str:nN { stdinfile } \l__didactic_stdinfile_tl
    \__didactic_kwarg_str:nN { args } \l__didactic_args_tl
    \__didactic_kwarg_str:nN { interpreter } \l__didactic_interpreter_tl
    \__didactic_kwarg_str:nN { cwd } \l__didactic_cwd_tl
    \__didactic_basedir_resolve:
    \__didactic_kwarg_str:nN { basedir } \l__didactic_basedir_tl
    \__didactic_kwarg_bool:nN { chdir } \l__didactic_chdir_bool
    \__didactic_kwarg_bool:nN { tty } \l__didactic_tty_bool
    \bool_if:NF \l__didactic_echo_bool
      { \str_put_right:Nn \l__didactic_call_str { , echo = False } }
    \__didactic_kwarg_bool:nN { showcommand } \l__didactic_showcommand_bool
    \__didactic_kwarg_str:nN { commandtext } \l__didactic_commandtext_tl
    \__didactic_kwarg_str:nN { prompt } \l__didactic_prompt_tl
    \__didactic_kwarg_raw:nN { timeout } \l__didactic_timeout_tl
    \__didactic_kwarg_raw:nN { idle } \l__didactic_idle_tl
    \clist_if_empty:NF \l__didactic_deps_clist
      {
        \seq_set_from_clist:NN \l_tmpa_seq \l__didactic_deps_clist
        \__didactic_kwarg_list:nN { deps } \l_tmpa_seq
      }
    \__didactic_kwarg_str:nN { lang } \l__didactic_lang_tl
    \__didactic_kwarg_bool:nN { fullwidth } \l__didactic_fullwidth_bool
    \__didactic_pyliteral:Ne \l__didactic_tmp_str
      { \clist_use:Nn \l__didactic_minted_clist { , } }
    \str_put_right:Nn \l__didactic_call_str { , minted_opts = }
    \str_put_right:NV \l__didactic_call_str \l__didactic_tmp_str
    \str_put_right:Nn \l__didactic_call_str { #3 ) }
    \exp_args:NV \pyc \l__didactic_call_str
  }
%    \end{macrocode}
%
% The user-level commands differ only in the Python function they call.
% |\runshell| runs its argument through the shell, so pipes and 
% redirections work.
% The values are local to a group, so nothing leaks between runs.
%    \begin{macrocode}
\NewDocumentCommand{\runpython}{s O{} m}
  {
    \group_begin:
      \__didactic_run_reset:
      \bool_set_false:N \l__didactic_shell_bool
      \IfBooleanT{#1}{ \bool_set_true:N \l__didactic_fullwidth_bool }
      \__didactic_run_keys:n {#2}
      \bool_if:NTF \l__didactic_shell_bool
        {
          \tl_clear:N \l__didactic_args_tl
          \tl_clear:N \l__didactic_interpreter_tl
          \__didactic_run:nnn { didactic_shell } {#3} { , shell = True }
        }
        { \__didactic_run:nnn { didactic_output } {#3} { } }
    \group_end:
  }
\NewDocumentCommand{\runshell}{s O{} m}
  {
    \group_begin:
      \__didactic_run_reset:
      \IfBooleanT{#1}{ \bool_set_true:N \l__didactic_fullwidth_bool }
      \__didactic_run_keys:n {#2}
      \__didactic_run:nnn { didactic_shell } {#3} { , shell = True }
    \group_end:
  }
\ExplSyntaxOff
%    \end{macrocode}
% \end{macro}
% \end{macro}
% \end{macro}
% \end{macro}
%
% \subsection{Contrasting code examples}
%
% Sometimes we want to contrast two code examples side by side.
% \begin{macro}{\textbytext}
% For example |\textbytext{\lipsum[1]}{\lipsum[1]}| should typeset the two 
% examples side by side.
% \ltnote{This is a note to test if it interferes with the text-by-text.}
% \textbytext{\lipsum[1]}{\lipsum[1]}
% 
% We can also use the starred version to use the full width.
% (This is in fact what we did in \cref{ExampleSideBySide} above.)
% In this case we use the space from the margin notes to expand into the 
% margin.
% \textbytext*{\lipsum[1]}{\lipsum[1]}
%
% This means that we can use the unstarred versions in floats.
% If we want to use the full width in the float, we expect the user to use the 
% |fullwidth| environment manually to set up the float properly.
%
% To do this we first add a |fullwidth| environment\footnote{%
%   Similarly to \url{https://tex.stackexchange.com/a/350944/17418}.
% }.
% We can get the |adjustwidth| environment from the |changepage| package 
% whenever |memoir| isn't used\footnote{%
%   The |memoir| class uses |changepage|, that's the origin of the package.
% }.
%
% In a float, the |fullwidth| environment reaches into the margin, so we tell 
% \textsf{marginfix} (version 1.5 and later) to keep the margin beside the 
% float empty (|\marginnotereservefloat|), rather than leave it to 
% \textsf{marginfix} to see it.
% |\@captype| is defined only inside a float.
%    \begin{macrocode}
\RequirePackage{changepage}
\RequirePackage{calc}
\newlength{\@didactic@textbytext@oldcolumnwidth}
\NewDocumentEnvironment{fullwidth}{}{%
  \ifdefined\@captype
    \ifdefined\marginnotereservefloat\marginnotereservefloat\fi
  \fi
  \setlength{\columnwidth}{\textwidth+2em+\marginparwidth+\marginparsep}
  \if@twoside
    \IfStrEqCase{\@didactic@marginparmargin}{%
        {inner}{\begin{adjustwidth*}{-\marginparwidth-\marginparsep}{-2em}}
        {left}{\begin{adjustwidth}{-\marginparwidth-\marginparsep}{-2em}}
        {outer}{\begin{adjustwidth*}{-2em}{-\marginparwidth-\marginparsep}}
        {right}{\begin{adjustwidth}{-2em}{-\marginparwidth-\marginparsep}}
      }[\relax]
  \else
    \IfStrEqCase{\@didactic@marginparmargin}{%
        {inner}{\begin{adjustwidth}{-\marginparwidth-\marginparsep}{-2em}}
        {left}{\begin{adjustwidth}{-\marginparwidth-\marginparsep}{-2em}}
        {outer}{\begin{adjustwidth}{-2em}{-\marginparwidth-\marginparsep}}
        {right}{\begin{adjustwidth}{-2em}{-\marginparwidth-\marginparsep}}
      }[\relax]
  \fi
}{
  \if@twoside
    \IfStrEqCase{\@didactic@marginparmargin}{%
      {inner}{\end{adjustwidth*}}
      {left}{\end{adjustwidth}}
      {outer}{\end{adjustwidth*}}
      {right}{\end{adjustwidth}}
    }[\relax]
  \else
    \end{adjustwidth}
  \fi
}
%    \end{macrocode}
%
% Now to the |\textbytext| command.
% We simply set up a |tabular| environment\footnote{%
%   This requires the |array| package.
%   We can't use the |tabularx| package since that one expands the arguments 
%   several times to find a good width.
%   That doesn't go too well with |pythontex| and |minted|.
% } with two columns and use it inside a |fullwidth| environment.
% We note that if the optional star is used, we also block the margin and use 
% the full width.
% This can't be used inside a float.
%
% The two columns share the line, with the gap of code side by side 
% (|\didacticpairgap|, see |\codebycodesetup|) between them and no space at 
% the sides, so that the table is exactly as wide as the line.
% (They used to be |0.49\columnwidth| each, which with the |tabular|'s own 
% space around the columns made the table some 13 to 17\,pt too wide: into 
% the margin, or with the star past the margin's outer edge to the edge of 
% the paper.)
%    \begin{macrocode}
\RequirePackage{array}
\NewDocumentCommand{\textbytext}{s+m+m}{%
  \IfBooleanTF{#1}
    {\blockmargin\begin{fullwidth}}
    {\begin{center}}
  \begin{tabular}{@{}p{\dimexpr(\linewidth-\didacticpairgap)/2\relax}%
      @{\hspace{\didacticpairgap}}%
      p{\dimexpr(\linewidth-\didacticpairgap)/2\relax}@{}}
    #2 & #3
  \end{tabular}
  \IfBooleanTF{#1}
    {\end{fullwidth}\unblockmargin}
    {\end{center}}
}
%    \end{macrocode}
% \end{macro}
%
% Now, we could ask ourselves: why didn't we put that |\blockmargin| and 
% |\unblockmargin| inside the |fullwidth| environment?
% The reason is that we want to be able to use the |fullwidth| environment in 
% other cases, for instance, in figures.
% In floats we don't need it: \textsf{marginfix} keeps the margin beside a 
% float empty by default, and with |notebesidefloats=use| the |fullwidth| 
% environment marks its float so that it does so too.
% And even if we tried, it wouldn't work, since the |\blockmargin| and 
% |\unblockmargin| don't work in outer par mode (inside floats).
% (See the |marginfix| documentation for details.)
%
% \begin{environment}{didacticpair}
% \begin{macro}{\codebycodesetup}
% Code side by side has its own layout, shared by |\codebycode|, 
% |\runbyrun| and |didactic_pair|: the |didacticpair| environment.
% It takes the column specification of a |tabular|, and optionally the 
% input line to give in warnings.
% On the slides the columns fill the frame, in a smaller font (|slides|, 
% |fontsize=\tiny| by default).
% In article mode they fill the full width, margin included (|fullwidth|, 
% on by default), with the margin blocked so that no notes are set beside 
% them; in a float, where |\blockmargin| doesn't work, our |fullwidth| marks 
% the float instead.
% The minted options for article mode are |notes|, empty by default, so the 
% document's own |\setminted| applies.
