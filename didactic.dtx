% \subsection{Adding margin notes of different kinds}
%
% We want to add titled margin notes.
% These margin notes should use indentation since they might contains several 
% paragraphs.
%
% \begin{macro}{\indentedmarginpar}
% We start with the indented margin notes.
% They simply take a text as argument and typeset it in the margin: 
% |\indentedmarginpar{this is the text}|.
% \indentedmarginpar{this is the text}
%    \begin{macrocode}
% Gives us indentation in the margin notes.
% Adapted from https://tex.stackexchange.com/a/257171
\RequirePackage{ragged2e}
\setlength{\RaggedRightParindent}{\parindent}
%    \end{macrocode}
% We mark the note as deferrable for \textsf{marginfix} (version 1.5 and 
% later), so that it may give way to footnotes when the margin is full, see 
% |\marginnotepriority|.
% We mark it after setting the font, since \textsf{marginfix} records the 
% font there for the cue that starts the rest of a split note.
% Older versions don't know the command, and then we skip it.
%    \begin{macrocode}
\NewDocumentCommand{\indentedmarginpar}{+m}{%
  \edef\@didactic@nobreak{%
    \if@nobreak\noexpand\@nobreaktrue\else\noexpand\@nobreakfalse\fi}%
  \marginpar{%
    \foottextfont%
    \ifdefined\marginnotedeferrable\marginnotedeferrable\fi
    \setlength{\parindent}{2em}%
    \@afterindentfalse\@afterheading #1%
    \global\@didactic@nobreak
  }%
  \global\@didactic@nobreak
}
%    \end{macrocode}
% The |\@afterheading| above gives the first paragraph of the note no 
% indentation.
% It works through the flag |\if@nobreak|, which is global, and the first 
% paragraph of the note clears it.
% But a heading uses the same flag to leave the first paragraph after it 
% unindented.
% So a note placed between a heading and its first paragraph would indent 
% that paragraph.
% That's why we save the flag before the note and restore it after.
% We restore it at the end of the note as well, while its box is being set, since
% \LaTeX\ looks at the flag when the note goes to the page, in the output routine, and
% adds a place to break if it is clear: between a heading and what follows it.
%
% If the \textsf{corrigenda} package is loaded (before or after us), we let it 
% use |\indentedmarginpar| for its margin notes.
% Not in |beamer| though: there \textsf{corrigenda} has already turned its 
% margin notes off, and |\foottextfont| is only defined by |memoir|.
%    \begin{macrocode}
\AtBeginDocument{%
  \@ifpackageloaded{corrigenda}{%
    \@ifclassloaded{beamer}{}{\SetErratumMarginNote{\indentedmarginpar}}%
  }{}%
}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\newnotetype}
% Now, let's add a command to add margin notes with a title.
% The |\newnotetype{\titlenote}{Title]| command creates a new command 
% |\titlenote| that takes a text as argument and typesets it in the margin with 
% the title |Title|: |\titlenote{this is the text}|.
% \newnotetype{\titlenote}{Title}
% \titlenote{this is the text}
%    \begin{macrocode}
\NewDocumentCommand{\newnotetype}{omm}{%
  \@ifclassloaded{beamer}{%
    \NewDocumentCommand{#2}{+m}{\relax}
  }{%
    \IfValueTF{#1}
      {\NewDocumentCommand{#2}{+m}{%
        \indentedmarginpar{#1{#3:} ##1}%
      }}
      {\NewDocumentCommand{#2}{+m}{%
        \indentedmarginpar{\emph{#3:} ##1}%
      }}%
  }
}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\NewNoteType}
% It can also be useful to be able to turn the notes off.
% For instance, we might want notes to appear in one version, but not in 
% others.
% Then we'd like a switch to simply turn them off.
% Also, we don't want these notes to appear in |beamer|, so we define them to 
% be off by default in that case.
%
% However, to achieve this, we must change the behaviour when creating new 
% notes: we need the name, not the |\command| as an argument.
% This is why we have the |\NewNoteType| command.
%
% \ltnote{This is a note with a title, using the note defined by the package.}
% We can use it like this:
% |\NewNoteType{lt}{Learning theory}|
% \NewNoteType{lt}{Learning theory}
% This creates a new note type |\lt|.
% |\lt{This is a note}| yields the note on the side.
% \lt{This is a note}
%
% We can also turn the notes off and on with |\ltoff| and |\lton|.
% \ltoff
% \lt{This is another note while off.}
% \lton
% \lt{This is another note while on, we didn't see the one we used while off.}
% \ltnote{This is a note with a title, using the note defined by the package.}
%
% Let's look at the implementation.
% We first create a new boolean for the note type.
% This will keep track of whether the note type is on or off, should be typeset 
% in the margin or if it does nothing.
% As mentioned above, we want to turn the notes off by default in |beamer|.
%    \begin{macrocode}
\NewDocumentCommand{\NewNoteType}{omm}{%
  \newbool{#2}
  \@ifclassloaded{beamer}
    {\boolfalse{#2}}
    {\booltrue{#2}}
%    \end{macrocode}
% Then we create the commands to turn the notes off and on.
% These must be created with |\expandafter\newcommand| to get the name of the
% note type.
% (|\NewDocumentCommand| can't accept names constructed with |\csname|.)
%    \begin{macrocode}
  \expandafter\newcommand\csname #2off\endcsname{\boolfalse{#2}}
  \expandafter\newcommand\csname #2on\endcsname{\booltrue{#2}}
%    \end{macrocode}
% We define the command differently depending on whether we want a custom
% formatting for the title of not.
% Same as before, we must use |\expandafter\newcommand| to construct these
% commands.
%    \begin{macrocode}
  \IfValueTF{#1}{%
    \expandafter\newcommand\csname #2\endcsname[1]{%
      \ifbool{#2}{%
        \indentedmarginpar{#1{#3:} ##1}%
      }{\relax}%
  }}{%
    \expandafter\newcommand\csname #2\endcsname[1]{%
      \ifbool{#2}{%
        \indentedmarginpar{\emph{#3:} ##1}%
      }{\relax}%
  }}%
}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\ltnote}
% We provide a few different types of margin notes.
% That way we can also include translations for them.
%    \begin{macrocode}
\ProvideTranslation{swedish}{Learning theory}{Lärandeteori}
\NewNoteType{ltnote}{\GetTranslationWarn{Learning theory}}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\marginnotecontinued}
% When \textsf{marginfix} splits a note over two pages (with 
% |\marginnotepriority{split}|), the rest starts with a cue.
% We give it in the language of the document, with the translation 
% |continued|, which is also there for other things that continue on the next 
% page, like long tables; and we add |continued on the next page| for their 
% feet.
% The cue is kept as it is and translated only where it is typeset.
% We set it in italics, like the titles of the notes.
% Without |memoir|, \textsf{marginfix} is loaded further down, so we set the 
% cue, and the priority from the |notepriority| option, at the end of the 
% package.
% So a |\marginnotecontinued|, |\marginnotepriority|, 
% |\marginnotebesidefloats| or |\marginnoteoverflow| of your own must come 
% after 
% |\usepackage{didactic}|, which should be the last package anyway; given 
% before, ours replaces it.
%    \begin{macrocode}
\ProvideTranslation{swedish}{continued}{forts.}
\ProvideTranslation{swedish}{continued on the next page}{forts.\ på nästa sida}
\AtEndOfPackage{%
  \ifdefined\marginnotecontinued
    \marginnotecontinued{\emph{(\GetTranslation{continued})}}%
  \fi
  \ifdefined\marginnotepriority
    \expandafter\marginnotepriority\expandafter{\@didactic@notepriority}%
  \fi
  \ifdefined\marginnotebesidefloats
    \expandafter\marginnotebesidefloats\expandafter
      {\@didactic@notebesidefloats}%
  \fi
  \ifdefined\marginnoteoverflow
    \expandafter\marginnoteoverflow\expandafter
      {\@didactic@noteoverflow}%
  \else
    \if@didactic@noteoverflowgiven
      \PackageWarningNoLine{didactic}{%
        The option noteoverflow needs marginfix 1.6 or later;\MessageBreak
        it has no effect with this one}%
    \fi
    \@ifclassloaded{beamer}
      {\let\marginnoteoverflow\@gobble}
      {\let\marginnoteoverflow\@didactic@oldmarginfix}%
  \fi}
\def\@didactic@oldmarginfix#1{%
  \PackageWarning{didactic}{%
    \string\marginnoteoverflow\space needs marginfix 1.6 or
    later;\MessageBreak
    it has no effect with this one}}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\MFX@fit@spilled}
% |noteoverflow=break| needs |\vadjust pre|, which Xe\TeX\ doesn't have.
% There \textsf{marginfix} carries the notes that don't fit to a later page, and 
% says so for a note that hits the limit, but otherwise only in the log.
% We say it for every such note: where it was called out and where it ended up.
% The hook is \textsf{marginfix}'s macro for a note that is carried, from 
% version~1.6; a note in the mode |carry| was meant to be.
% If it isn't there, we say once that the mode can't work.
%    \begin{macrocode}
\def\@didactic@spillwarning#1{%
  \expandafter\ifx\csname mfx@bo@#1\endcsname\MFX@break
    \PackageWarningNoLine{didactic}{%
      A margin note from page \csname mfx@sp@#1\endcsname\space is
      on page \the\c@page:\MessageBreak
      noteoverflow=break needs pdfLaTeX or LuaLaTeX}%
  \fi
  \@didactic@MFX@fit@spilled{#1}}
\AtBeginDocument{%
  \ifdefined\MFX@break
    \ifdefined\pdftexversion\else\ifdefined\directlua\else
      \ifdefstring{\@didactic@noteoverflow}{break}{%
        \ifdefined\MFX@fit@spilled
          \let\@didactic@MFX@fit@spilled\MFX@fit@spilled
          \let\MFX@fit@spilled\@didactic@spillwarning
        \else
          \PackageWarningNoLine{didactic}{%
            noteoverflow=break needs pdfLaTeX or LuaLaTeX;\MessageBreak
            with this engine margin notes may move to a later page}%
        \fi
      }{}%
    \fi\fi
  \fi}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\@didactic@marginlog}
% Tools that check the notes, for instance that each margin note is printed 
% on the page of its mark, need to know where the margin column is.
% Guessing it from the positions of the words fails when the text reaches 
% into the gap before the margin, as code set side by side can.
% So, outside |beamer|, we write the margin column to the log once, when the 
% layout is final, at the end of |\begin{document}|, in one line:
% \begin{quote}
% |didactic-margin: odd=|\meta{x} |even=|\meta{x} |width=|\meta{w}
% \end{quote}
% where \meta{x} is the left edge of the margin column on odd and on even 
% pages and \meta{w} its width, |\marginparwidth|, all in big points 
% (\texttt{bp}), the unit of PDF coordinates, from the left edge of the page.
% In a one-sided document |odd| and |even| are the same.
% The text block starts at 1\,in${}+{}$|\hoffset|${}+{}$|\oddsidemargin| 
% (|\evensidemargin| on even pages of a two-sided document).
% A margin to the right of it starts |\marginparsep| after the text, and one 
% to the left starts |\marginparsep| and |\marginparwidth| before it.
% Which side it is on we ask \textsf{marginfix}, which places the notes 
% (|\MFX@marginside|, which knows |memoir|'s |\marginparmargin| too); it 
% leaves |\@tempcnta| at 1 for the right and $-1$ for the left.
%    \begin{macrocode}
\@ifclassloaded{beamer}{}{%
  \def\@didactic@marginx#1#2{%
    \begingroup
      \c@page=#1\relax
      \@tempcnta\@ne
      \ifdefined\MFX@marginside
        \MFX@marginside
      \else
        \if@mparswitch
          \ifodd\c@page\else\@tempcnta\m@ne\fi
        \fi
        \if@reversemargin\@tempcnta-\@tempcnta\fi
      \fi
      \@tempdima\dimexpr 1in+\hoffset\relax
      \if@twoside
        \ifodd\c@page
          \advance\@tempdima\oddsidemargin
        \else
          \advance\@tempdima\evensidemargin
        \fi
      \else
        \advance\@tempdima\oddsidemargin
      \fi
      \ifnum\@tempcnta>\z@
        \advance\@tempdima\dimexpr\textwidth+\marginparsep\relax
      \else
        \advance\@tempdima-\dimexpr\marginparsep+\marginparwidth\relax
      \fi
      \xdef#2{\fpeval{round(\@tempdima/1bp, 2)}}%
    \endgroup}
  \def\@didactic@marginlog{%
    \@didactic@marginx\@ne\@didactic@marginodd
    \@didactic@marginx\tw@\@didactic@margineven
    \typeout{didactic-margin: odd=\@didactic@marginodd\space
      even=\@didactic@margineven\space
      width=\fpeval{round(\marginparwidth/1bp, 2)}}}
  \ifdefined\AddToHook
    \AddToHook{begindocument/end}{\@didactic@marginlog}
  \else
    \AtBeginDocument{\@didactic@marginlog}
  \fi}
%    \end{macrocode}
% \end{macro}
