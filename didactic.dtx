% \begin{macro}{\@didactic@keep@tie}
% \begin{macro}{\@didactic@keep@gap}
% \begin{macro}{\@didactic@keep@L}
% At the start of a listing we settle whether it may take along what leads into 
% it (|\@didactic@keep@tie|): if it doesn't fit on what is left of the page, that 
% stays empty, and so does the place of what moves with it.
% \TeX\ has put everything before the listing on the page by now, since the 
% list has ended the paragraph, so |\pagegoal| less |\pagetotal| and |\pagedepth| 
% is the room left (unless the page is still empty, when |\pagegoal| is 
% |\maxdimen|, or already holds more than the page, when we can't tell).
% With |keepleadin| the paragraph before goes along.
% At least its last line does, and on a page with stretch \TeX\ may well take more,
% so to hold the limit we count on the most it would take: two lines, and all of it
% if it has up to three lines (|\prevgraf|), for then it would rather break above it
% than leave its first line alone.
% With them goes the space above the paragraph, which \TeX\ discards if it breaks
% there: |\@didactic@keep@pstart| is where the paragraph before it ended
% (|\@didactic@keep@pend|), or the listing, if that is less than a line above, and
% otherwise where the paragraph started, since then something else stands there.
% Right after another listing there is no such paragraph (the end of a list is a 
% place to break), so only this room would stay empty.
% If a heading is chained to those lines (the state, below), all goes: the room 
% when the heading started would stay empty, |\@didactic@keep@headroom|.
% If that is more than |keepmaxgap| the tie is released: 
% |\if@didactic@keep@movable| is false, and the page can break before the 
% listing, as without |keepleadin|.
% This doesn't depend on the listing: \TeX\ uses that place only if the listing 
% doesn't fit, and that is why we can decide before we know its lines, at the 
% header line of a chunk of \textsf{noweb}, say, which is on the page before the 
% first line of the code comes.
% Lines are lines of the text, |\@didactic@keep@L|, the |\baselineskip| at 
% the beginning of the document; the listing's own lines may be smaller.
%
% At the end of the listing, |\@didactic@keep@gap| says whether it counts as long: 
% when it has more than |keeplines| lines, or when it doesn't fit on what is left 
% of the page and the tie is released.
% By now, that is, after a |\par| in vertical mode, in a group as \LaTeX's own 
% paragraphs do it: glue, such as the space before the listing, doesn't go to 
% the page until something else makes \TeX\ look, and the room would be that 
% much off.
% It fits as \TeX\ reckons it: the page less all it can shrink, and without the 
% depth of the last line.
% If the listing then can't break after all, since |keepends| asks for more
% lines than it has or than fit, it goes to the next page, not tied to what leads
% into it, and we warn, from the pages, at the end of the run.
% A listing right under a heading says so if it breaks, the same way, with the pages
% of its first and last lines (|\@didactic@keep@breakwrite|).
% The first write is a whatsit, and glue after a whatsit is a legal break, so a
% |\nobreak| follows it; after the last line a break was legal anyway.
% |\@didactic@keep@relstart| writes to the |.aux| file the page that the last
% line of the lead-in ends up on, when the tie is released, for \TeX\ may yet take
% that line along by itself and then nothing is parted (after a negative penalty
% too, which is a break that was asked for, unless it came from the lead-in's own
% paragraph, a |\pagebreak| in its last line, which is a break within it), and
% |\@didactic@keep@relend| writes the page that the
% first line ended up on, whatever comes first: a listing, the header of a chunk,
% or code side by side.
%    \begin{macrocode}
\newdimen\@didactic@keep@L
\AtBeginDocument{\@didactic@keep@L\baselineskip}
\def\@didactic@keep@tie{%
  \global\@didactic@keep@movabletrue
  \ifnum\@didactic@keepmaxgap>\z@
    \ifvmode\ifinner\else
    \ifdim\pagegoal<\maxdimen
      \dimen@\dimexpr\pagegoal-\pagetotal-\pagedepth\relax
      \@didactic@keep@ifchained{%
        \dimen@\dimexpr\@didactic@keep@headroom-\@didactic@keep@headdepth\relax
        \ifdim\dimen@>\@didactic@keepmaxgap\@didactic@keep@L
          \global\@didactic@keep@movablefalse
        \fi
      }{%
      \ifdim\dimen@<\z@\else
          \if@didactic@keep@afterlisting\else
            \if@didactic@keepleadin
              \ifnum\prevgraf>\thr@@
                \advance\dimen@2\@didactic@keep@L
              \else
                \ifdim\@didactic@keep@pstart<\pagetotal
                  \dimen@\dimexpr\pagegoal-\@didactic@keep@pstart\relax
                \else
                  \advance\dimen@\prevgraf\@didactic@keep@L
                \fi
              \fi
            \fi
          \fi
        \ifdim\dimen@>\@didactic@keepmaxgap\@didactic@keep@L
          \global\@didactic@keep@movablefalse
        \fi
      \fi
      }%
    \fi\fi\fi
  \fi}
\def\@didactic@keep@gap{%
  \@didactic@keep@longfalse
  \ifnum\@didactic@keep@n>\@didactic@keeplines
