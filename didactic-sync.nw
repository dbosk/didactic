def classify_names(tokens, reading, raw):
    """Return the indices of uses of our names, and the names defined."""
    uses = []
    defined = {}
    index = 0
    while index < len(tokens):
        token = tokens[index]
        if token.kind != "cs":
            index += 1
            continue
        if token.text in MENTIONS:
            index += 1 + MENTIONS[token.text]
            continue
        if token.text in DEFINERS or token.text in COPIERS:
            target = defined_name(tokens, index + 1)
            if target is None:
                index += 1
                continue
            if tokens[target].text in SHORT_NAMES:
                defined.setdefault(tokens[target].text, token.text)
            elif tokens[target].text in OUR_NAMES:
                line = raw.count("\n", 0, tokens[target].start)
                name = tokens[target].text
                reading.errors.append((line, f"this file redefines \\{name}"))
            index = target + 1
            if token.text in COPIERS:
                <<skip the source of a copy, reporting an alias>>
            continue
        if token.text in OUR_NAMES:
            uses.append(index)
        index += 1
    return uses, defined


