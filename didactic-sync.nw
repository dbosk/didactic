  spec.loader.exec_module(sync)
  assert sync.OUR_NAMES == tuple(sync.PAIRS)
  codes = {code for pair in sync.PAIRS.values() for code in pair}
  assert set(sync.LANGUAGES) == codes
  for code in codes:
    assert sync.BLOCK_BEGIN.match("\\begin{" + code + "}")
    assert f"{code}=abc123" in str(sync.Stamp("abc123", "abc123"))
  entry = " ".join(f"{code}=-" for code in sync.LANGUAGES)
  assert sync.STAMP_COMMENT.fullmatch("% sync " + entry)
  assert not sync.BLOCK_BEGIN.match("\\begin{de}")


