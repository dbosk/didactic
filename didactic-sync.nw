<<functions>>=
def range_ends(root, revisions):
    """Return the two commits of a revision range, or `None`."""
    three_dots = "..." in revisions
    start, end = revisions.split("..." if three_dots else "..", 1)
    start, end = start or "HEAD", end or "HEAD"
    if three_dots:
        start = git(root, "merge-base", start, end)
    else:
        start = git(root, "rev-parse", "--verify", "-q", start + "^{commit}")
    if start is None:
        return None
    if git(root, "rev-parse", "--verify", "-q", end + "^{commit}") is None:
        return None
    return start.strip(), end
@

A file that can't be read as blocks can hide any number of pairs, so at the
end of the range it's an error like any other, instead of a listing that looks
complete.
At the start of the range it's only worth a warning: the branch may be what
repairs the file, and it would otherwise never get a listing.
That listing is short of the pairs that couldn't be read at the start, though,
and the warning goes to the standard error, which a pull request's description
doesn't get.
So the listing itself says that it may be incomplete.

<<constants>>=
UNREAD_START = (
    "Part of the start of the range can't be read (see the warnings), "
    "so a pair re-stamped after such a place isn't listed."
)
<<functions>>=
def pairs_at(root, commit, names):
    """Return (file, pair) for the pairs in files at a commit, and errors."""
    found = []
    errors = []
    for name in names:
        text = git(root, "show", f"{commit}:{name}")
        if text is not None:
            pairs, _, problems, _ = read_pairs(text, name)
            found += [(name, pair) for pair in pairs]
            errors += [
                f"{name}:{line + 1}: {message}" for line, message in problems
            ]
    return found, errors
