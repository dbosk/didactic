@

The rest of the rules is about the arguments.
Both of our names are only ours, so a use is followed by two groups, and
anything else is an error: [[\ensv{a}]] alone, or [[\ensv\foo]].
Before each group there may be spaces, a line end and comments, but not a
blank line: [[\didactictr]] is long, so \LaTeX\ takes the [[\par]] of a blank
line for the second argument and prints the Swedish in the English edition.
Inside a group anything goes but a chunk, a block or a verbatim environment.
What we keep of a side is that span of the file itself, comments included, as
a change in a comment, or in quoted code, is a change of the string, but
without stamps (\cref{sec:sync-pairs}); and the line where the use ends, as
that's where a comment can stand without being in the way of the rest of the
command.
A use that a file's own [[\ensv]] leaves alone is kept too, as a place in the
count of the uses on its line, and nothing else.

<<classes>>=
@dataclass
class Ensv:
    """A use of `\\ensv`, with the 0-based line where it starts and ends."""

    first: int
    last: int
    en: str
    sv: str
    own: bool = False
<<functions>>=
def find_ensv(reading):
    """Return all uses of `\\ensv` in a source, in order."""
    raw = "\n".join(reading.lines)
    tokens = tokens_of(reading)
    uses, defined = classify_names(tokens, reading, raw)
    if "ensv" in defined:
        own = PROVIDED_ENSV if defined["ensv"] == "providecommand" else OWN_ENSV
        reading.notes.append((None, own))
    for comment in doubtful_comments(tokens):
        line = raw.count("\n", 0, comment.start)
        reading.notes.append((line, DOUBTFUL_COMMENT))
    note_trailing_stamps(tokens, reading, raw)
    found = []
    for index in uses:
        name = tokens[index].text
        line = raw.count("\n", 0, tokens[index].start)
        groups = read_groups(tokens, index + 1)
        if name in defined:
            last = raw.count("\n", 0, groups[1][1].start) if groups else line
            found.append(Ensv(line, last, "", "", own=True))
            continue
        if groups is None:
            reading.errors.append((line, f"this \\{name} needs two arguments"))
            continue
        (open_en, close_en), (open_sv, close_sv) = groups
        found.append(
            Ensv(
                line,
                raw.count("\n", 0, close_sv.start),
                without_stamps(raw[open_en.end : close_en.start]),
                without_stamps(raw[open_sv.end : close_sv.start]),
            )
        )
    return found


def note_trailing_stamps(tokens, reading, raw):
    """Note the stamp comments that end lines of text, by line."""
    for token in tokens:
        if token.kind == "comment":
            if match := STAMP_COMMENT.search(token.text):
                line = raw.count("\n", 0, token.start)
                reading.trailing_stamps[line] = match.group("entries")
