<<test helpers>>=
def base_of_three(repo):
  """On master: three stamped pairs and an `\\ensv`. Then on a branch."""
  path = repo / "contents.nw"
  path.write_text(
    blocks("en", "sv", en="One.", sv="Ett.")
    + "Text.\n"
    + blocks("en", "sv", en="Two.", sv="Två.")
    + "Text.\n"
    + blocks("en", "sv", en="Three.", sv="Tre.")
    + "\\ensv{Four}{Fyra}\n"
  )
  for text in ("One.", "Two.", "Three.", "Four"):
    target = f"contents.nw:{name_of(path, text)}"
    assert run(repo, "--stamp", target).returncode == 0, target
  assert run(repo, "contents.nw").returncode == 0
  commit(repo, "base")
  git(repo, "checkout", "-q", "-b", "topic")
  return path


def line_of(path, text):
  for number, line in enumerate(path.read_text().splitlines(), 1):
    if text in line:
      return number
  raise AssertionError(text)


def name_of(path, text):
  """The report's name of the pair that holds `text`: for a block pair, the
  line of its first begin."""
  lines = path.read_text().splitlines()
  number = line_of(path, text) - 1
  if "\\ensv" in lines[number] or "\\didactictr" in lines[number]:
    return number + 1
  while not lines[number].lstrip().startswith("\\begin{"):
    number -= 1
  above = number - 1
  while above >= 0 and (
    not lines[above].strip() or lines[above].lstrip().startswith("%")
  ):
    above -= 1
  if above >= 0 and lines[above].startswith("\\end{"):
    number = above
    while not lines[number].lstrip().startswith("\\begin{"):
      number -= 1
  return number + 1


def stamp_at(repo, path, text):
  target = f"{path.name}:{name_of(path, text)}"
  result = run(repo, "--stamp", target)
  assert result.returncode == 0, result.stderr


def assert_nothing_listed(result):
  assert result.returncode == 0
  assert "No pair" in result.stdout
  listing = result.stdout.replace("No pair was re-stamped", "")
  assert "re-stamped" not in listing
