<<functions>>=
def check_branch(revisions):
    """List what a range re-stamped with one side changed; return a status."""
    root = git(".", "rev-parse", "--show-toplevel")
    ends = root and range_ends(root.strip(), revisions)
    if not ends:
        print(f"{revisions}: not a range of this repository", file=sys.stderr)
        return STATUS_ERROR
    root = root.strip()
    changed = git(
        root, "diff", "--name-only", "--no-renames", "-z", ends[0], ends[1]
    )
    if changed is None:
        print(f"{revisions}: git diff failed", file=sys.stderr)
        return STATUS_ERROR
    names = [
        name
        for name in changed.split("\0")
        if name.endswith(STAMPED_SUFFIXES)
    ]
    old_pairs, old_errors = pairs_at(root, ends[0], names)
    new_pairs, new_errors = pairs_at(root, ends[1], names)
    for message in old_errors:
        print(f"at the start of the range: {message}", file=sys.stderr)
    for message in new_errors:
        print(message, file=sys.stderr)
    if new_errors:
        return STATUS_ERROR
    print_restamped(restamped_one_side(old_pairs, new_pairs))
    if old_errors:
        print(UNREAD_START)
    return STATUS_OK


def print_restamped(found):
    """Print what the branch check found."""
    if not found:
        print("No pair was re-stamped with only one side changed.")
    for path, old, pair, language, certain in found:
        other = "sv" if language == "en" else "en"
        what = (
            f"re-stamped, only {language} changed"
            if certain
            else f"new, or re-stamped with only {language} changed"
        )
        print(f"{path}:{pair.target}: {what}")
        change = word_diff(getattr(old, language), getattr(pair, language))
        print(f"  {language}: {change}")
        print(f"  {other} now: {' '.join(getattr(pair, other).split())}")
