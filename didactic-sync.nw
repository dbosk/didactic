@pytest.fixture
def repo(tmp_path):
  git(tmp_path, "init", "-q", "-b", "master")
  git(tmp_path, "config", "user.name", "Test")
  git(tmp_path, "config", "user.email", "test@example.org")
  git(tmp_path, "config", "commit.gpgsign", "false")
  return tmp_path


def commit(repo, message="change"):
  git(repo, "add", "-A")
  git(repo, "commit", "-q", "-m", message)


def blocks(first, second, en="The cat sat.", sv="Katten satt."):
  text = {"en": en, "sv": sv}
  return (
    f"\\begin{{{first}}}\n{text[first]}\n\\end{{{first}}}\n"
    f"\\begin{{{second}}}\n{text[second]}\n\\end{{{second}}}\n"
  )


ORDERS = [("en", "sv"), ("sv", "en")]


def stamped_file(repo, order, name="contents.nw"):
  """A committed file with one stamped pair, in the given block order."""
  path = repo / name
  path.write_text(blocks(*order))
  assert run(repo, "--stamp", f"{name}:1").returncode == 0
  commit(repo, "stamp")
  return path
