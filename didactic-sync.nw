  assert_nothing_listed(run(repo, "master...HEAD"))
  assert "[-Uno.-]{+One.+}" in run(repo, "master..HEAD").stdout


def test_a_two_dot_range_is_a_range_too(repo):
  path = base_of_three(repo)
  path.write_text(path.read_text().replace("One.", "Uno."))
  stamp_at(repo, path, "Uno.")
  commit(repo, "a typo")
  assert "[-One.-]{+Uno.+}" in run(repo, "master..HEAD").stdout


def test_a_range_that_does_not_exist_is_an_error(repo):
  base_of_three(repo)
  assert run(repo, "nosuchbranch...HEAD").returncode == 2
  assert run(repo, "master...nosuchbranch").returncode == 2
