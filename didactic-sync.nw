def test_a_byte_order_mark_stays_first_and_hides_nothing(repo):
  path = repo / "contents.nw"
  mark = b"\xef\xbb\xbf"
  path.write_bytes(mark + blocks("en", "sv").encode())
  assert "contents.nw:1: new pair" in run(repo, "contents.nw").stdout
  assert run(repo, "--stamp", "contents.nw:1").returncode == 0
  data = path.read_bytes()
  assert data.startswith(mark + b"\\begin{en} % sync en=")
  assert data.count(mark) == 1
  assert run(repo, "contents.nw").returncode == 0


