  result = run(repo, "-v", "contents.nw")
  assert result.returncode == 0, result.stdout
  assert "0 pairs" in result.stdout


@pytest.mark.parametrize("line", ["@@ not the end", "@foo"])
def test_only_a_lone_at_sign_ends_a_chunk(repo, line):
