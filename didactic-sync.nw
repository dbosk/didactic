The doubtful comments are found by counting the braces as we go, from the
start of the file, since a group may well span lines.

<<functions>>=
def doubtful_comments(tokens):
    """Return the comments that start in an open group and hold our names."""
    doubtful = []
    depth = 0
    for token in tokens:
        if token.kind == "{":
            depth += 1
        elif token.kind == "}":
            depth = max(0, depth - 1)
        elif token.kind in (PAR, OPAQUE):
            depth = 0
        elif token.kind == "comment" and depth > 0:
            if any("\\" + name in token.text for name in OUR_NAMES):
                doubtful.append(token)
    return doubtful
@

Reading the two groups follows the rule above: comments are skipped between
them, and a blank line, a chunk or anything else ends the search.

<<functions>>=
def read_groups(tokens, index):
    """Return the braces of two groups at `index`, or `None`."""
    groups = []
    while len(groups) < 2:
        while index < len(tokens) and tokens[index].kind == "comment":
            index += 1
        if index >= len(tokens) or tokens[index].kind != "{":
            return None
        close = matching_brace(tokens, index)
        if close is None:
            return None
        groups.append((tokens[index], tokens[close]))
        index = close + 1
    return groups


def matching_brace(tokens, index):
    """Return the index of the brace that closes the one at `index`."""
    depth = 0
    for position in range(index, len(tokens)):
        kind = tokens[position].kind
        if kind == OPAQUE:
            return None
        if kind == "{":
            depth += 1
        elif kind == "}":
            depth -= 1
            if depth == 0:
                return position
    return None
